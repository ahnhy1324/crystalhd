#
#  Broadcom Crystal HD (BCM970012) controller Makefile.
#
#
KVER ?= $(shell uname -r)
KDIR ?= /lib/modules/$(KVER)/build
DESTDIR ?=
MODULEDIR ?= /lib/modules/$(KVER)/updates
UDEVDIR ?= /lib/udev/rules.d
FIRMWAREDIR ?= /lib/firmware


INCLUDES  = -I$(KDIR)/include
INCLUDES += -I$(src)/../../include
INCLUDES += -I$(src)/../../include/link
INCLUDES += -I$(src)/../../include/flea

FIRMWARE  = ../../firmware/fwbin/70015/bcm70015fw.bin
FIRMWARE += ../../firmware/fwbin/70012/bcm70012fw.bin

ccflags-y   = -D__KERNEL__ -DMODULE $(INCLUDES) $(INC)
ccflags-y  += -Wall -Wstrict-prototypes -Wno-trigraphs -Werror -O2

OBJ :=	crystalhd_lnx.o \
	crystalhd_misc.o \
	crystalhd_cmds.o \
	crystalhd_hw.o \
	crystalhd_linkfuncs.o \
	crystalhd_fleafuncs.o \
	crystalhd_flea_ddr.o

PWD := $(CURDIR)

obj-m := crystalhd.o
crystalhd-objs := $(OBJ)

.PHONY: all install install-module install-udev install-firmware clean distclean

all:
	$(MAKE) -C $(KDIR) M=$(PWD) modules

install: install-module install-udev install-firmware

install-module: crystalhd.ko
	install -D -m 0644 crystalhd.ko $(DESTDIR)$(MODULEDIR)/crystalhd.ko
	@if [ -z "$(DESTDIR)" ] && command -v depmod >/dev/null 2>&1; then \
		depmod -a $(KVER); \
	fi

install-udev:
	install -D -m 0644 20-crystalhd.rules $(DESTDIR)$(UDEVDIR)/20-crystalhd.rules

install-firmware:
	install -D -m 0644 ../../firmware/fwbin/70015/bcm70015fw.bin \
		$(DESTDIR)$(FIRMWAREDIR)/bcm70015fw.bin
	install -D -m 0644 ../../firmware/fwbin/70012/bcm70012fw.bin \
		$(DESTDIR)$(FIRMWAREDIR)/bcm70012fw.bin

clean:
	rm -f *.map *.list *.o *.ko crystalhd.mod.c $(OBJ)

distclean:
	rm -f *.map *.list *.o *.ko crystalhd.mod.c $(OBJ)
	rm -f configure config.status config.log *~*
	rm -rf autom4te.cache
	rm -f Makefile
	rm -f Module.symvers
