# Kbuild supplies the selected kernel's include paths. KDIR belongs to the
# outer wrapper and is not defined for a direct external-module build.
INCLUDES := -I$(src)/../../include
INCLUDES += -I$(src)/../../include/link
INCLUDES += -I$(src)/../../include/flea

ccflags-y := -D__KERNEL__ -DMODULE $(INCLUDES) $(INC)
ccflags-y += -Wall -Wstrict-prototypes -Wno-trigraphs -Werror -O2

# Distribution identity is independent of the legacy numeric ioctl version.
# Both inputs are included in source archives; building does not require Git.
crystalhd_bundle_version := $(shell cat $(src)/../../VERSION)
crystalhd_package_version := 3.10.3-pm-arbiter
ifeq ($(strip $(crystalhd_bundle_version)),)
$(error Missing CrystalHD VERSION)
endif
ifeq ($(strip $(crystalhd_package_version)),)
$(error Missing CrystalHD PACKAGE_VERSION)
endif
ccflags-y += -DCRYSTALHD_BUNDLE_VERSION=\"$(crystalhd_bundle_version)\"
ccflags-y += -DCRYSTALHD_PACKAGE_VERSION=\"$(crystalhd_package_version)\"

obj-m := crystalhd.o
crystalhd-objs := crystalhd_lnx.o \
	crystalhd_misc.o \
	crystalhd_cmds.o \
	crystalhd_stream.o \
	crystalhd_hw.o \
	crystalhd_linkfuncs.o \
	crystalhd_fleafuncs.o \
	crystalhd_flea_ddr.o \
	crystalhd_pm_shadow.o

CRYSTALHD_FW_RESEARCH ?= 0
ifneq ($(CRYSTALHD_FW_RESEARCH),0)
ifneq ($(CRYSTALHD_FW_RESEARCH),1)
$(error CRYSTALHD_FW_RESEARCH must be 0 or 1)
endif
ifeq ($(filter y m,$(CONFIG_CRYPTO_HASH)),)
$(error CRYSTALHD_FW_RESEARCH=1 requires CONFIG_CRYPTO_HASH=y or m)
endif
ccflags-y += -DCRYSTALHD_ENABLE_FW_RESEARCH
crystalhd-objs += crystalhd_fw_research.o
endif

# Opt-in parent lifetime support; it does not expose a decoding video node.
CRYSTALHD_V4L2 ?= 0
ifneq ($(CRYSTALHD_V4L2),0)
ifneq ($(CRYSTALHD_V4L2),1)
$(error CRYSTALHD_V4L2 must be 0 or 1)
endif
ifeq ($(filter y m,$(CONFIG_VIDEO_DEV)),)
$(error CRYSTALHD_V4L2=1 requires CONFIG_VIDEO_DEV=y or m)
endif
ccflags-y += -DCRYSTALHD_ENABLE_V4L2
crystalhd-objs += crystalhd_v4l2.o
endif
