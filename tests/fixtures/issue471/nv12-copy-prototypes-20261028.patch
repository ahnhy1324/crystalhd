@@ -4301,12 +4301,61 @@ static bool CopyNv12Pixels(const Surface &source, Surface *destination,
-  for (unsigned int row = 0; row < height; ++row) {
-    memcpy(destination->planes[0] +
-               static_cast<size_t>(row) * destination->pitch[0],
-           source.planes[0] + static_cast<size_t>(row) * source.pitch[0],
-           width);
-  }
-  for (unsigned int row = 0; row < (height + 1) / 2; ++row) {
-    memcpy(destination->planes[1] +
-               static_cast<size_t>(row) * destination->pitch[1],
-           source.planes[1] + static_cast<size_t>(row) * source.pitch[1],
-           width);
-  }
+#if defined(__SSE2__)
+  const bool stream_public = purpose == CopyPurpose::DecodedPublic &&
+      !destination->object_fds.empty() && width >= 256;
+  bool streamed = false;
+#endif
+  const auto copy_plane = [&](unsigned int plane, unsigned int rows) {
+    if (width == 0 || rows == 0)
+      return;
+#if defined(__SSE2__)
+    if (stream_public) {
+      for (unsigned int row = 0; row < rows; ++row) {
+        const uint8_t *input = source.planes[plane] +
+            static_cast<size_t>(row) * source.pitch[plane];
+        uint8_t *output = destination->planes[plane] +
+            static_cast<size_t>(row) * destination->pitch[plane];
+        const size_t prefix =
+            (64U - (reinterpret_cast<uintptr_t>(output) & 63U)) & 63U;
+        const size_t stream_end = prefix +
+            ((static_cast<size_t>(width) - prefix) & ~size_t{63});
+        // Keep cached edge writes on separate cache lines from the streaming
+        // stores. No load or store crosses the logical row or its padding.
+        if (prefix != 0)
+          memcpy(output, input, prefix);
+        for (size_t offset = prefix; offset < stream_end; offset += 64) {
+          for (size_t block = 0; block < 64; block += 16) {
+            const __m128i pixels = _mm_loadu_si128(
+                reinterpret_cast<const __m128i *>(input + offset + block));
+            _mm_stream_si128(
+                reinterpret_cast<__m128i *>(output + offset + block), pixels);
+          }
+        }
+        if (stream_end < width)
+          memcpy(output + stream_end, input + stream_end, width - stream_end);
+        streamed = true;
+      }
+      return;
+    }
+#endif
+    // A tightly packed plane has no intervening pitch padding. Keep cropped
+    // or strided rows separate, and bound the whole-plane size on 32-bit hosts.
+    if (source.pitch[plane] == width && destination->pitch[plane] == width &&
+        rows <= SIZE_MAX / width) {
+      memcpy(destination->planes[plane], source.planes[plane],
+             static_cast<size_t>(width) * rows);
+      return;
+    }
+    for (unsigned int row = 0; row < rows; ++row) {
+      memcpy(destination->planes[plane] +
+                 static_cast<size_t>(row) * destination->pitch[plane],
+             source.planes[plane] +
+                 static_cast<size_t>(row) * source.pitch[plane],
+             width);
+    }
+  };
+  copy_plane(0, height);
+  copy_plane(1, chroma_rows);
+#if defined(__SSE2__)
+  // Complete both planes' streaming writes before returning CPU ownership.
+  if (streamed)
+    _mm_sfence();
+#endif
