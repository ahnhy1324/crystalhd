+static void config_scope_results(void)
+{
+	groups++;
+	for(unsigned selector=0;selector<=12;selector++)for(unsigned nonstate=0;nonstate<128;nonstate++) {
+		reset_config();struct packed_gate_result out={123};config_version_gate(selector,nonstate,&out);
+		check(out.status==((selector==CRYSTALHD_FW_RESEARCH_VERSION_ONLY && !nonstate)?0:-EINVAL) && no_effects(),
+		      "actual compile opt-in VERSION-only gate refuses all state/codec selectors before session or loader action");
+	}
+	reset_config();configure_config(&adapter.cmds,adapter.generation);
+	check(hardware.research_scl_config_probe && hardware.research_mfd_generation==adapter.generation &&
+	      hardware.research_mfd_owner==&research_owner && no_effects(),"actual harness configuration sets only the new opt-in and frozen owner/generation metadata");
+	clear_config_capture(&adapter.cmds);
+	check(!hardware.research_scl_config_probe && !hardware.research_mfd_generation && !hardware.research_mfd_owner &&
+	      no_effects(),"actual post-download harness block clears the new flag and frozen identities without any I/O");
+	for(unsigned missing=0;missing<6;missing++) {
+		reset_config();hardware.research_scl_config_probe=true;hardware.research_staging_probe=true;
+		if(missing==0)hardware.research_staging_probe=false;
+		else if(missing==1)hardware.research_mfd_owner=NULL;
+		else if(missing==2)hardware.research_mfd_generation=0;
+		else if(missing==3)hardware.pfnDevDRAMRead=NULL;
+		else if(missing==4)hardware.pfnDevDRAMWrite=NULL;
+		else hardware.pfnReadDevRegister=NULL;
+		check(crystalhd_flea_download_fw(&hardware,(const uint8_t *)firmware.words,sizeof(firmware.words))==BC_STS_INV_ARG &&
+		      no_effects() && !pci_reads && !pci_clears && !hardware.research_scl_config_probe &&
+		      !hardware.research_staging_probe && !hardware.research_mfd_owner && !hardware.research_mfd_generation,
+		      "missing staging/owner/generation/PIO/REG prerequisites reject before effects and consume all mode flags");
+	}
+	for(unsigned conflict=0;conflict<14;conflict++) {
+		reset_config();hardware.research_scl_config_probe=true;hardware.research_staging_probe=true;
+		switch(conflict) {
+		case 0:hardware.research_mfd_latch_probe=true;break;case 1:hardware.research_mfd_colour_probe=true;break;
+		case 2:hardware.research_mfd_scl_probe=true;hardware.research_scl_selector=1;break;
+		case 3:hardware.research_scl_port_probe=true;hardware.research_scl_selector=1;break;
+		case 4:hardware.research_scl_port_latch=true;break;case 5:hardware.research_mfd_packed_probe=true;hardware.research_mfd_packed_pattern=1;break;
+		case 6:hardware.research_mfd_packed_window_probe=true;break;case 7:hardware.research_mfd_packed_observed_geometry_probe=true;break;
+		case 8:hardware.research_mfd_packed_hsize4_probe=true;break;case 9:hardware.research_mfd_packed_normal_probe=true;break;
+		case 10:hardware.research_mfd_packed_scl_input_probe=true;break;case 11:hardware.research_mfd_packed_pattern=1;break;
+		case 12:hardware.research_mfd_colour_value=0x405ac3;break;case 13:hardware.research_scl_selector=1;break;
+		}
+		check(crystalhd_flea_download_fw(&hardware,(const uint8_t *)firmware.words,sizeof(firmware.words))==BC_STS_INV_ARG &&
+		      no_effects() && !pci_reads && !config_calls && !hardware.research_scl_config_probe,
+		      "all peripheral flags and unused foreign scalar configurations conflict before any loader action");
+	}
+	for(unsigned short_image=0;short_image<3;short_image++) {
+		reset_config();hardware.research_scl_config_probe=true;hardware.research_staging_probe=true;
+		const unsigned bytes=short_image==0?0:short_image==1?CRYSTALHD_FLEA_MIN_FIRMWARE_SIZE-1:96+16+4-4;
+		check(crystalhd_flea_download_fw(&hardware,(const uint8_t *)firmware.words,bytes)==BC_STS_INV_ARG &&
+		      no_effects() && !hardware.research_scl_config_probe,"malformed or short staging image cannot enter custom qualification");
+	}
+}
