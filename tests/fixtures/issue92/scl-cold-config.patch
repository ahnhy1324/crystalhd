+static void config_retirement_results(void)
+{
+	groups++;
+	for(unsigned error=1;error<=27;error++) {
+		reset_config();check(run_config()==BC_STS_CMD_CANCELLED,"retirement test starts from real completed qualification");
+		config_active=false;suspend_status=(BC_STATUS)error;
+		const unsigned reads=dev_reads,pcis=pci_reads;
+		check(run_close()==(BC_STATUS)error && hardware.dev_started && pci_reads==pcis && dev_reads==reads &&
+		      hardware.research_mfd_pci_isolated && !(pci_command&PCI_COMMAND_MASTER) &&
+		      adapter.cmds.session_owner==&research_owner && hardware.tx_actq==&queues[1] &&
+		      hardware.rx_actq==&queues[3] && hardware.rx_rdyq==&queues[4],
+		      "all stock-suspend failures retain isolated owner/backing without extra configuration probe reads or MASTER enable");
+	}
+	for(unsigned error=1;error<=3;error++) {
+		reset_config();check(run_config()==BC_STS_CMD_CANCELLED,"post-stop test starts from complete qualification");
+		config_active=false;pci_fail_at=pci_reads+error;
+		check(run_close()==BC_STS_IO_ERROR && hardware.dev_started && fatal_stops==1 &&
+		      hardware.dma_fault && !adapter.present && hardware.research_mfd_pci_isolated &&
+		      adapter.cmds.session_owner==&research_owner && hardware.rx_freeq==&queues[2] &&
+		      !(pci_command&PCI_COMMAND_MASTER),"each post-stock-stop checked PCI failure quarantines instead of backing retirement");
+	}
+	reset_config();config_fault_at=22;config_fault_value=UINT32_MAX;
+	check(run_config()==BC_STS_IO_ERROR && fatal_stops==1,"invalid isolated bank sample quarantines");
+	config_active=false;const unsigned reads=dev_reads,pcis=pci_reads;
+	check(run_close()==BC_STS_IO_ERROR && !suspend_calls && dev_reads==reads && pci_reads==pcis &&
+	      hardware.dev_started && adapter.cmds.session_owner==&research_owner && hardware.rx_freeq==&queues[2] &&
+	      hardware.tx_actq==&queues[1],"quarantined probe cannot reuse stock close to override retained backing or access registers");
+}
