+/* Independent cold-config scalar oracle. New words are synthetic nonzero
+ * reserved-clean encodings, not reset defaults, dimensions or clock acknowledgements.
+ */
+static const uint32_t config_addresses[14] = {
+	0x540800,0x540804,0x540808,0x54080c,0x540810,0x540814,0x540818,
+	0x54081c,0x540854,0x540880,0x5408a4,0x502200,0x70004,0x540800,
+};
+static const uint32_t config_reserved[14] = {
+	0xffff0000,0xfffffff1,0xfffffe08,0xffffff00,0xf800f800,0xf800f800,
+	0xf800f800,0xf800f800,0xfffffffe,0xfffffffc,0xffffff00,0,0,0xffff0000,
+};
+static const uint32_t config_guard_addresses[10] = {
+	0x540000,0x4000d4,0xe0004,0x540064,0x540030,
+	0x540800,0x540804,0x540854,0x540880,0x5408a4,
+};
+static uint32_t config_values[14], config_offsets[128], config_raw[128];
+static bool config_active, config_pci_failed, config_pending_cycle;
+static unsigned config_reads, config_calls, config_logs, config_summaries, config_reject_logs;
+static unsigned config_fault_at, config_async_at, config_async_kind, config_pci_async_at;
+static unsigned config_pio_write_fault, config_pio_read_fault;
+static unsigned config_field_mutate_at, config_staging_logs, config_pci_value_at;
+static uint16_t config_pci_value;
+static uint32_t config_fault_value, config_mfd_revision, config_gisb, config_bridge;
+static uint32_t config_repeat, config_command;
+
+static bool config_current(void)
+{
+	return adapter.present && adapter.hw_accessible && !hardware.dma_fault &&
+		adapter.generation == 0x1020304050607080ULL &&
+		adapter.cmds.session_owner == &research_owner;
+}
+
+static void config_context_fault(unsigned kind)
+{
+	if (kind == 1) hardware.dma_fault = true;
+	else if (kind == 2) adapter.present = 0;
+	else if (kind == 3) adapter.generation++;
+	else if (kind == 4) adapter.cmds.session_owner = &hardware;
+	else if (kind == 5) adapter.hw_accessible = false;
+}
+
+static uint32_t read_config(uint32_t offset)
+{
+	uint32_t value = 0;
+	bool admitted = false;
+	check(!config_pci_failed && !fatal_stops, "cold-config never reads REG after checked PCI failure or quarantine");
+	check(config_reads < ARRAY_SIZE(config_offsets), "cold-config has a bounded literal REG footprint");
+	for (unsigned n=0;n<13;n++) if (offset==config_addresses[n]) {
+		value=config_values[n]; admitted=true; break;
+	}
+	if (!admitted) switch(offset) {
+	case 0x540000: value=config_mfd_revision; break;
+	case 0x4000d4: value=config_gisb; break;
+	case 0xe0004: value=config_bridge; break;
+	case 0x540064: value=config_repeat; break;
+	case 0x540030: value=config_command; break;
+	case BCHP_SCRUB_CTRL_SCRUB_ENABLE: break;
+	case BCHP_WRAP_MISC_INTR2_PCI_STATUS: value=SCRAM_KEY_DONE_INT_BIT; break;
+	default: check(false, "cold-config reads only fixed scalars or existing stock loader registers; never DATA/source pointers");
+	}
+	config_reads++;
+	if (config_reads==config_fault_at) value=config_fault_value;
+	if (config_reads<=ARRAY_SIZE(config_offsets)) {
+		config_offsets[config_reads-1]=offset;config_raw[config_reads-1]=value;
+	}
+	if (config_reads==config_async_at) config_context_fault(config_async_kind);
+	if (config_reads==config_field_mutate_at) hardware.research_scl_config_probe=true;
+	return value;
+}
