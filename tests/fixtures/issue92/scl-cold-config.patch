+static void config_version_gate(unsigned selector,unsigned nonstate,struct packed_gate_result *result)
+{
+	const struct crystalhd_fw_research_request request_value={.selector=selector};
+	const struct crystalhd_fw_research_request *request=&request_value;
+	const void *state=(nonstate&1)?&hardware:NULL,*controller=(nonstate&2)?&hardware:NULL;
+	const void *image=(nonstate&4)?&hardware:NULL,*packet=(nonstate&8)?&hardware:NULL;
+	const void *heap_packet=(nonstate&16)?&hardware:NULL,*clock=(nonstate&32)?&hardware:NULL,*uart=(nonstate&64)?&hardware:NULL;
+	result->status=0;
+#define CRYSTALHD_SCL_CONFIG_PROBE
+#include "packed-version-gate.h"
+#undef CRYSTALHD_SCL_CONFIG_PROBE
+}
