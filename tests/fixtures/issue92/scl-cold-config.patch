+		BCHP_SCL_HD_VERT_CONTROL, BCHP_SCL_HD_HORIZ_CONTROL,
+		BCHP_SCL_HD_BVB_IN_SIZE, BCHP_SCL_HD_PIC_OFFSET,
+		BCHP_SCL_HD_SRC_PIC_SIZE, BCHP_SCL_HD_DEST_PIC_SIZE,
+		BCHP_SCL_HD_ENABLE, BCHP_SCL_HD_TEST_PORT_CONTROL,
+		BCHP_SCL_HD_BVB_IN_STATUS, BCHP_MISC3_RESET_CTRL,
+		BCHP_CLK_PM_CTRL, BCHP_SCL_HD_REVISION_ID,
+	};
+	static const uint32_t reserved[] = {
+		BCHP_SCL_HD_REVISION_ID_reserved0_MASK,
+		BCHP_SCL_HD_TOP_CONTROL_reserved0_MASK |
+			BCHP_SCL_HD_TOP_CONTROL_reserved1_MASK,
+		BCHP_SCL_HD_VERT_CONTROL_reserved0_MASK |
+			BCHP_SCL_HD_VERT_CONTROL_reserved1_MASK,
+		BCHP_SCL_HD_HORIZ_CONTROL_reserved0_MASK,
+		BCHP_SCL_HD_BVB_IN_SIZE_reserved0_MASK |
+			BCHP_SCL_HD_BVB_IN_SIZE_reserved1_MASK,
+		BCHP_SCL_HD_PIC_OFFSET_reserved0_MASK |
+			BCHP_SCL_HD_PIC_OFFSET_reserved1_MASK,
+		BCHP_SCL_HD_SRC_PIC_SIZE_reserved0_MASK |
+			BCHP_SCL_HD_SRC_PIC_SIZE_reserved1_MASK,
+		BCHP_SCL_HD_DEST_PIC_SIZE_reserved0_MASK |
+			BCHP_SCL_HD_DEST_PIC_SIZE_reserved1_MASK,
+		BCHP_SCL_HD_ENABLE_reserved0_MASK,
+		BCHP_SCL_HD_TEST_PORT_CONTROL_reserved0_MASK,
+		BCHP_SCL_HD_BVB_IN_STATUS_reserved0_MASK,
+		0, 0, BCHP_SCL_HD_REVISION_ID_reserved0_MASK,
+	};
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (!values)
+		return BC_STS_INV_ARG;
+	memset(values, 0, sizeof(uint32_t) * ARRAY_SIZE(addresses));
+	sts = crystalhd_flea_scl_config_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		values[i] = hw->pfnReadDevRegister(hw->adp, addresses[i]);
+		if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner) ||
+		    (values[i] & reserved[i]))
+			return BC_STS_IO_ERROR;
+		if (((i == 0 || i == 13) && values[i] != 0x80) ||
+		    (i == 1 && values[i] != 0x0c) ||
+		    ((i == 8 || i == 9 || i == 10) && values[i]))
+			return BC_STS_IO_ERROR;
+	}
+	sts = crystalhd_flea_scl_config_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner) ||
+	    values[0] != 0x80 || values[13] != 0x80 || values[1] != 0x0c ||
+	    values[8] || values[9] || values[10])
+		return BC_STS_IO_ERROR;
+	return BC_STS_SUCCESS;
+}
