+static BC_STATUS crystalhd_flea_scl_config_probe(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	uint32_t first[14], second[14];
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (hw && (hw->research_mfd_pci_isolated || hw->research_mfd_deliberate_abort))
+		return BC_STS_BUSY;
+	sts = crystalhd_flea_scl_config_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	/* Persistent retirement duty precedes the attempted PCI isolation.
+	 * MASTER clear is not a bound on on-chip DDR consumers or BVB output.
+	 */
+	hw->research_mfd_pci_isolated = true;
+	pci_clear_master(hw->adp->pdev);
+	sts = crystalhd_flea_scl_config_sample(hw, generation, owner, first);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	sts = crystalhd_flea_scl_config_sample(hw, generation, owner, second);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	if (crystalhd_flea_scl_config_guard(hw, generation, owner) != BC_STS_SUCCESS ||
+	    !crystalhd_flea_mfd_packed_input_current(hw, generation, owner) ||
+	    memcmp(first, second, sizeof(first)))
+		goto quarantine;
+	/* Log only complete, reserved-clean, current, equal tuples. The word
+	 * order is the fixed address list above, not an atomic bank image.
+	 */
+	for (i = 0; i < ARRAY_SIZE(first); i++)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 scl-config: word=%u first=%08x second=%08x\n",
+			 i, first[i], second[i]);
+	dev_info(&hw->adp->pdev->dev,
+		 "issue92 scl-config: samples=2 words=14 stable=1 target-writes=0 source-pattern-writes=0 feed-starts=0 qualification-only\n");
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+
+quarantine:
+	crystalhd_hw_dma_fatal_stop(hw);
+	return BC_STS_IO_ERROR;
+}
