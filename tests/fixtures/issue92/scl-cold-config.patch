+/* Qualification of the observed cold profile only. The existing guard's
+ * fixed batches are not instantaneous cancellation of register callbacks.
+ * No mode, geometry, functional clock or all-engine idle is inferred here.
+ */
+static BC_STATUS crystalhd_flea_scl_config_guard(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	uint32_t status;
+	BC_STATUS sts;
+
+	sts = crystalhd_flea_mfd_packed_input_scl_guard(hw, generation, owner,
+						      0, true, &status);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	return status ? BC_STS_BUSY : BC_STS_SUCCESS;
+}
+
+/* Non-atomic scalar observations. New mode/geometry words are deliberately
+ * not pinned to guesses. Reset/clock words are coarse opaque observations,
+ * not per-engine gating or reset acknowledgement. No DATA port is read.
+ */
+static BC_STATUS crystalhd_flea_scl_config_sample(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, uint32_t *values)
