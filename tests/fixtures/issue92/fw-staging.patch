+	restore_write_status = BC_STS_IO_ERROR;
+	check(run_staging() == BC_STS_IO_ERROR && dram_writes == 3 &&
+	      dram_reads == 1 && !cmac_writes && !arm_run_writes && !heartbeats,
+	      "restore error wins over pattern error without bypassing restoration");
