+			reset();
+			BC_STATUS *injected[] = { &pattern_write_status,
+				&pattern_read_status, &restore_write_status,
+				&restore_read_status };
+			*injected[stage] = (BC_STATUS)status;
+			check(run_staging() == (BC_STATUS)status && dram_writes == 3 &&
+			      !cmac_writes && !arm_run_writes && !heartbeats &&
+			      !hardware.research_staging_probe &&
+			      !memcmp(&firmware, &firmware_before, sizeof(firmware)),
+			      "all pattern/restore failures attempt restoration and abort");
+			if (stage < 2)
