+static void staging_results(void)
+{
+	groups++;
+	reset();
+	check(crystalhd_flea_download_fw(&hardware,
+	      (const uint8_t *)firmware.words, sizeof(firmware.words)) ==
+	      BC_STS_SUCCESS && !dram_reads && bridge_reads == 1,
+	      "default-off download adds no readback or admission reads");
+	reset();
+	check(run_staging() == BC_STS_SUCCESS && dram_reads == 3 &&
+	      dram_writes == 3 && bridge_reads == 4 &&
+	      card_first == expected_image[0] && !hardware.research_staging_probe &&
+	      !memcmp(card_prefix, expected_image, sizeof(card_prefix)) &&
+	      card_suffix == expected_image[24] &&
+	      cmac_writes == 4 && arm_run_writes == 1 && heartbeats == 1 &&
+	      !memcmp(&firmware, &firmware_before, sizeof(firmware)),
+	      "matched staging read preserves ordinary authenticated boot");
+	reset();
+	hardware.research_staging_probe = true;
+	check(crystalhd_flea_download_fw(&hardware,
+	      (const uint8_t *)firmware.words, 96 + 16 + 4 - 4) ==
+	      BC_STS_INV_ARG && no_effects() && !hardware.research_staging_probe,
+	      "short valid payload rejects before hardware or pattern access");
+	reset();
+	hardware.pfnDevDRAMRead = NULL;
+	check(run_staging() == BC_STS_INV_ARG && no_effects() &&
+	      !hardware.research_staging_probe,
+	      "missing read callback rejects and consumes flag before MMIO");
+	reset();
+	bridge_initial = ARM_RUN_REQ_BIT;
+	check(run_staging() == BC_STS_BUSY && !dram_writes && !dram_reads &&
+	      !cmac_writes && !arm_run_writes && !heartbeats,
+	      "pre-write asserted run request prevents payload and start");
+	reset();
+	dram_status = BC_STS_IO_XFR_ERROR;
+	check(run_staging() == BC_STS_IO_XFR_ERROR && !dram_reads &&
+	      !cmac_writes && !arm_run_writes && !heartbeats,
+	      "payload write failure never advances to readback or start");
+	for (int status = BC_STS_ERROR; status <= BC_STS_PWR_MGMT; status++) {
+		if (status == BC_STS_SUCCESS)
+			continue;
+		reset();
+		read_status = (BC_STATUS)status;
+		check(run_staging() == read_status && dram_reads == 1 &&
+		      !cmac_writes && !arm_run_writes && !heartbeats &&
+		      !hardware.research_staging_probe &&
+		      !memcmp(&firmware, &firmware_before, sizeof(firmware)),
+		      "every non-success read status aborts before signature/start");
+	}
+	reset();
+	read_mismatch = true;
+	check(run_staging() == BC_STS_IO_ERROR && dram_reads == 1 &&
+	      !cmac_writes && !arm_run_writes && !heartbeats,
+	      "readback mismatch prevents signature and firmware execution");
+	reset();
+	bridge_final = ARM_RUN_REQ_BIT;
+	check(run_staging() == BC_STS_IO_ERROR && dram_reads == 1 &&
+	      !cmac_writes && !arm_run_writes && !heartbeats,
+	      "post-read asserted run request aborts before further effects");
+	for (unsigned stage = 0; stage < 4; stage++) {
+		for (int status = BC_STS_ERROR; status <= BC_STS_PWR_MGMT; status++) {
+			if (status == BC_STS_SUCCESS)
