+		mismatch_index = 0;
+		pattern_mismatch = stage == 0;
+		restore_mismatch = stage == 1;
+		check(run_staging() == BC_STS_IO_ERROR && dram_writes == 3 &&
+		      dram_reads == 3 && !cmac_writes && !arm_run_writes &&
+		      !memcmp(card_prefix, expected_image, sizeof(card_prefix)) &&
