+/* Fixed control-only namespace. No pointer, coefficient or pixel-port access.
+ * All 10 programmed MFD controls (including colour and STRIDE) and all five
+ * SCL controls are included in the indivisible reset reference.
+ */
+static const uint32_t crystalhd_joint_addresses[25] = {
+	BCHP_MFD_REVISION_ID, BCHP_MFD_PIC_FEED_CMD, BCHP_MFD_STRIDE,
+	BCHP_MFD_FIXED_COLOUR, BCHP_MFD_DISP_HSIZE, BCHP_MFD_PICTURE0_DISP_VERT_WINDOW,
+	BCHP_MFD_LAC_CNTL, BCHP_MFD_CHROMA_SAMPLING_CNTL, BCHP_MFD_DATA_MODE,
+	BCHP_MFD_TEST_PORT_CNTL, BCHP_MFD_TEST_MODE_CNTL, BCHP_MFD_FEEDER_CNTL,
+	BCHP_MFD_FEEDER_TIMEOUT_REPEAT_PIC_CNTL, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS,
+	BCHP_SCL_HD_REVISION_ID, BCHP_SCL_HD_TOP_CONTROL, BCHP_SCL_HD_VERT_CONTROL,
+	BCHP_SCL_HD_HORIZ_CONTROL, BCHP_SCL_HD_BVB_IN_SIZE, BCHP_SCL_HD_PIC_OFFSET,
+	BCHP_SCL_HD_SRC_PIC_SIZE, BCHP_SCL_HD_DEST_PIC_SIZE, BCHP_SCL_HD_ENABLE,
+	BCHP_SCL_HD_TEST_PORT_CONTROL, BCHP_SCL_HD_BVB_IN_STATUS,
+};
+static const uint32_t crystalhd_joint_reserved[25] = {
+	0xffff0000, 0xfffffffe, 0, 0xff000000, 0xffffe000, 0xe000e000,
+	0xfffff820, 0xfffffffe, 0xfffffffe, 0xfffffff0, 0xfffffff0, 0xfffffff0,
+	0xfc000000, 0xfffffff8, BCHP_SCL_HD_REVISION_ID_reserved0_MASK,
+	BCHP_SCL_HD_TOP_CONTROL_reserved0_MASK | BCHP_SCL_HD_TOP_CONTROL_reserved1_MASK,
+	BCHP_SCL_HD_VERT_CONTROL_reserved0_MASK | BCHP_SCL_HD_VERT_CONTROL_reserved1_MASK,
+	BCHP_SCL_HD_HORIZ_CONTROL_reserved0_MASK,
+	BCHP_SCL_HD_BVB_IN_SIZE_reserved0_MASK | BCHP_SCL_HD_BVB_IN_SIZE_reserved1_MASK,
+	BCHP_SCL_HD_PIC_OFFSET_reserved0_MASK | BCHP_SCL_HD_PIC_OFFSET_reserved1_MASK,
+	BCHP_SCL_HD_SRC_PIC_SIZE_reserved0_MASK | BCHP_SCL_HD_SRC_PIC_SIZE_reserved1_MASK,
+	BCHP_SCL_HD_DEST_PIC_SIZE_reserved0_MASK | BCHP_SCL_HD_DEST_PIC_SIZE_reserved1_MASK,
+	BCHP_SCL_HD_ENABLE_reserved0_MASK, BCHP_SCL_HD_TEST_PORT_CONTROL_reserved0_MASK,
