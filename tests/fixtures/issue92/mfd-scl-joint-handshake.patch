+/* Before stock powerdown: corroborate every saved control together. Never
+ * live-restore a subset, clear status, or substitute this for a consumer fence.
+ */
+static BC_STATUS crystalhd_flea_joint_retire(struct crystalhd_hw *hw)
+{
+	uint32_t first[25], second[25];
+	unsigned int i;
+	BC_STATUS sts;
+
+	if (!crystalhd_flea_joint_current(hw) || hw->research_joint_reset_corroborated)
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_joint_sample(hw, hw->research_joint_generation,
+			hw->research_joint_owner, hw->research_joint_saved, false, false, first);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	sts = crystalhd_flea_joint_sample(hw, hw->research_joint_generation,
+			hw->research_joint_owner, hw->research_joint_saved, false, false, second);
+	if (sts != BC_STS_SUCCESS || memcmp(first, second, sizeof(first)) || !crystalhd_flea_joint_current(hw))
+		return BC_STS_IO_ERROR;
+	for (i = 0; i < ARRAY_SIZE(first); i++)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 joint: phase=pre-powerdown-retire word=%u first=%08x second=%08x\n", i, first[i], second[i]);
+	hw->research_joint_reset_corroborated = true;
+	return BC_STS_SUCCESS;
+}
