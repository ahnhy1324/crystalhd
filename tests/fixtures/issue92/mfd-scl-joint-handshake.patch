+static bool crystalhd_flea_joint_binding(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	return hw && hw->adp && hw->adp->pdev && generation && owner &&
+		hw->pfnReadDevRegister && hw->pfnWriteDevRegister && hw->dev_started &&
+		READ_ONCE(hw->adp->present) && hw->adp->hw_accessible && !READ_ONCE(hw->dma_fault) &&
+		hw->adp->generation == generation && hw->adp->cmds.adp == hw->adp &&
+		hw->adp->cmds.hw_ctx == hw && hw->adp->cmds.session_module_pinned &&
+		hw->adp->cmds.session_owner == owner && hw->adp->cmds.state == BC_LINK_INVALID;
+}
+
+static bool crystalhd_flea_joint_current(struct crystalhd_hw *hw)
+{
+	return hw && hw->research_joint_pending && hw->research_joint_original_sampled &&
+		hw->research_mfd_pci_isolated && hw->research_joint_attempts <= 16 &&
+		!hw->research_scl_config_dirty && !hw->research_scl_reset_corroborated &&
+		!hw->research_scl_duty_generation && !hw->research_scl_duty_owner &&
+		!hw->research_mfd_reset_pending && !hw->research_mfd_reset_cold_sampled &&
+		!hw->research_mfd_reset_post_sampled && !hw->research_mfd_reset_generation &&
+		!hw->research_mfd_reset_owner && !hw->research_mfd_hsize_dirty &&
+		!hw->research_mfd_hsize_request_sampled && !hw->research_mfd_hsize_reset_corroborated &&
+		crystalhd_flea_joint_binding(hw, hw->research_joint_generation, hw->research_joint_owner);
+}
+
+/* expected=NULL admits a paired reserved-clean cold profile, not defaults.
+ * After START, command and ENABLE may self-change; defined error flags remain
+ * separate raw observations. No incomplete or stale tuple is published.
+ */
+static BC_STATUS crystalhd_flea_joint_sample(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, const uint32_t *expected,
+		bool after_start, bool observe_status, uint32_t *values)
+{
+	uint32_t observed[25];
+	unsigned int i;
+	BC_STATUS sts;
+
+	if (!values || !crystalhd_flea_joint_binding(hw, generation, owner) ||
+	    (expected && !crystalhd_flea_joint_current(hw)))
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS || !crystalhd_flea_joint_binding(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	for (i = 0; i < ARRAY_SIZE(observed); i++) {
+		if (!crystalhd_flea_joint_binding(hw, generation, owner) ||
+		    (expected && !crystalhd_flea_joint_current(hw)))
+			return BC_STS_IO_ERROR;
+		observed[i] = hw->pfnReadDevRegister(hw->adp, crystalhd_joint_addresses[i]);
+		if (!crystalhd_flea_joint_binding(hw, generation, owner) ||
+		    (expected && !crystalhd_flea_joint_current(hw)) || observed[i] == 0xffffffff ||
+		    (observed[i] & crystalhd_joint_reserved[i]))
+			return BC_STS_IO_ERROR;
+		if (expected && !((after_start && (i == 1 || i == 22)) ||
+		    (observe_status && (i == 13 || i == 24))) && observed[i] != expected[i])
+			return BC_STS_IO_ERROR;
+	}
+	/* STRIDE interpretation follows the observed CTRL, including partial setup. */
+	if ((observed[11] & 1) && (observed[2] & 0xffff0000))
+		return BC_STS_IO_ERROR;
+	if (!expected) {
+		static const uint32_t cold_scl[11] = {
+			0x80, 0x0c, 0, 0, 0x02d000f0, 0, 0x02d000f0,
+			0x02d000f0, 0, 0, 0,
+		};
+		if (observed[0] != 0x50 || observed[1] || observed[11] || observed[13] ||
+		    observed[2] != 0x00800080 || observed[4] != 0x780 || observed[5] != 0x436 ||
+		    (observed[10] != 0 && observed[10] != 4) ||
+		    (observed[12] & 0x01000000) || memcmp(observed + 14, cold_scl, sizeof(cold_scl)))
+			return BC_STS_IO_ERROR;
+	}
+	sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS || !crystalhd_flea_joint_binding(hw, generation, owner) ||
+	    (expected && !crystalhd_flea_joint_current(hw)))
+		return BC_STS_IO_ERROR;
+	memcpy(values, observed, sizeof(observed));
+	return BC_STS_SUCCESS;
+}
+
+/* All target addresses/literals are frozen in this caller, not userspace. */
+static BC_STATUS crystalhd_flea_joint_attempt(struct crystalhd_hw *hw,
+		unsigned int word, uint32_t value, uint32_t *expected)
+{
+	uint32_t observed[25];
+
+	if (!expected || word >= 25 || !crystalhd_flea_joint_current(hw) ||
+	    hw->research_joint_reset_corroborated || hw->research_joint_start_attempted ||
+	    hw->research_joint_attempts >= 15)
+		return BC_STS_IO_ERROR;
+	/* Arm before the void callback; a missing readback never licenses retry. */
+	hw->research_joint_attempts++;
+	hw->pfnWriteDevRegister(hw->adp, crystalhd_joint_addresses[word], value);
+	if (!crystalhd_flea_joint_current(hw))
+		return BC_STS_IO_ERROR;
+	expected[word] = value;
+	return crystalhd_flea_joint_sample(hw, hw->research_joint_generation,
+			hw->research_joint_owner, expected, false, false, observed);
+}
+
+/* One non-atomic bundle: never infer same-cycle propagation or beat counts. */
+static BC_STATUS crystalhd_flea_joint_observe(struct crystalhd_hw *hw,
+		const uint32_t *expected, bool after_start, uint32_t *bundle)
+{
+	static const uint32_t addresses[7] = {
+		BCHP_MFD_TEST_PORT_DATA, BCHP_MFD_BVB_SAMPLE_DATA, BCHP_MFD_FEED_STATUS,
+		BCHP_MFD_FEEDER_BVB_STATUS, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS,
+		BCHP_SCL_HD_TEST_PORT_DATA, BCHP_SCL_HD_BVB_IN_STATUS,
+	};
+	static const uint32_t reserved[7] = {
+		0xf0000000, 0xfc000000, 0xdfffe000, 0xfffffffc, 0xfffffff8, 0,
+		BCHP_SCL_HD_BVB_IN_STATUS_reserved0_MASK,
+	};
+	uint32_t before[25], after[25], observed[11];
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (!bundle || !crystalhd_flea_joint_current(hw))
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_joint_sample(hw, hw->research_joint_generation,
+			hw->research_joint_owner, expected, after_start, true, before);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		if (!crystalhd_flea_joint_current(hw))
+			return BC_STS_IO_ERROR;
+		observed[i] = hw->pfnReadDevRegister(hw->adp, addresses[i]);
+		if (!crystalhd_flea_joint_current(hw) || observed[i] == 0xffffffff ||
+		    (observed[i] & reserved[i]))
+			return BC_STS_IO_ERROR;
+	}
+	sts = crystalhd_flea_joint_sample(hw, hw->research_joint_generation,
+			hw->research_joint_owner, expected, after_start, true, after);
+	if (sts != BC_STS_SUCCESS || !crystalhd_flea_joint_current(hw))
+		return BC_STS_IO_ERROR;
+	observed[7] = before[13]; observed[8] = after[13];
+	observed[9] = before[24]; observed[10] = after[24];
+	memcpy(bundle, observed, sizeof(observed));
+	return BC_STS_SUCCESS;
+}
