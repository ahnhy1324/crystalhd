+/* Pending observations preserve context until checked stock stop. They are
+ * neither an active-bank observation nor a source/downstream buffer lease.
+ */
+static bool crystalhd_flea_mfd_reset_current(struct crystalhd_hw *hw)
+{
+	return hw && hw->adp && hw->adp->pdev &&
+		hw->pfnReadDevRegister && hw->pfnWriteDevRegister &&
+		hw->research_mfd_reset_pending && hw->research_mfd_reset_generation &&
+		hw->research_mfd_reset_owner && hw->research_mfd_pci_isolated &&
+		!hw->research_scl_config_dirty && !hw->research_scl_reset_corroborated &&
+		!hw->research_scl_duty_generation && !hw->research_scl_duty_owner &&
+		READ_ONCE(hw->adp->present) && hw->adp->hw_accessible &&
+		!READ_ONCE(hw->dma_fault) &&
+		hw->adp->generation == hw->research_mfd_reset_generation &&
+		hw->adp->cmds.hw_ctx == hw &&
+		hw->adp->cmds.session_module_pinned &&
+		hw->adp->cmds.session_owner == hw->research_mfd_reset_owner;
+}
+
+static bool crystalhd_flea_research_stop_current(struct crystalhd_hw *hw)
+{
+	if (hw->research_mfd_reset_pending)
+		return crystalhd_flea_mfd_reset_current(hw);
+	return !hw->research_scl_config_dirty || crystalhd_flea_scl_size_current(hw);
+}
+
+/* CTRL=0 has AVC/MPEG STRIDE fields spanning all 32 bits. Do not apply the
+ * packed-STRIDE interpretation. LINE_ADDR0 is opaque; no pointer is followed.
+ * These paired, non-atomic control reads never touch a pixel DATA port.
+ */
+static BC_STATUS crystalhd_flea_mfd_reset_sample(struct crystalhd_hw *hw,
+		uint32_t *values)
+{
+	static const uint32_t addresses[20] = {
+		BCHP_MFD_REVISION_ID, BCHP_MFD_PIC_FEED_CMD, BCHP_MFD_FEEDER_CNTL,
+		BCHP_MFD_PICTURE0_LINE_ADDR_0, BCHP_MFD_STRIDE, BCHP_MFD_DISP_HSIZE,
+		BCHP_MFD_PICTURE0_DISP_VERT_WINDOW, BCHP_MFD_LAC_CNTL,
+		BCHP_MFD_CHROMA_SAMPLING_CNTL, BCHP_MFD_DATA_MODE,
+		BCHP_MFD_FEEDER_TIMEOUT_REPEAT_PIC_CNTL, BCHP_MFD_TEST_MODE_CNTL,
+		BCHP_MFD_TEST_PORT_CNTL, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS,
+		BCHP_MFD_PIC_OFFSET, BCHP_MFD_LUMA_NMBY, BCHP_MFD_CHROMA_NMBY,
+		BCHP_MFD_FEED_STATUS, BCHP_MFD_FEEDER_BVB_STATUS, BCHP_MFD_REVISION_ID,
+	};
+	static const uint32_t reserved[20] = {
+		0xffff0000, 0xfffffffe, 0xfffffff0, 0, 0, 0xffffe000, 0xe000e000,
+		0xfffff820, 0xfffffffe, 0xfffffffe, 0xfc000000, 0xfffffff0,
+		0xfffffff0, 0xfffffff8, 0xfffffff8, 0xfffffc00, 0xfffffc00,
+		0xdfffe000, 0xfffffffc, 0xffff0000,
+	};
+	uint32_t observed[20];
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (!values || !crystalhd_flea_mfd_reset_current(hw))
+		return BC_STS_IO_ERROR;
+	/* The inherited guard has fixed batches, not per-callback cancellation. */
+	sts = crystalhd_flea_scl_config_guard(hw, hw->research_mfd_reset_generation,
+			hw->research_mfd_reset_owner);
+	if (sts != BC_STS_SUCCESS || !crystalhd_flea_mfd_reset_current(hw))
+		return BC_STS_IO_ERROR;
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		if (!crystalhd_flea_mfd_reset_current(hw))
+			return BC_STS_IO_ERROR;
+		observed[i] = hw->pfnReadDevRegister(hw->adp, addresses[i]);
+		if (!crystalhd_flea_mfd_reset_current(hw) || observed[i] == 0xffffffff ||
+		    (observed[i] & reserved[i]) ||
+		    ((i == 0 || i == 19) && observed[i] != 0x50) ||
+		    ((i == 1 || i == 2 || i == 13) && observed[i]) ||
+		    (i == 10 && (observed[i] & 0x01000000)))
+			return BC_STS_IO_ERROR;
+	}
+	sts = crystalhd_flea_scl_config_guard(hw, hw->research_mfd_reset_generation,
+			hw->research_mfd_reset_owner);
+	if (sts != BC_STS_SUCCESS || !crystalhd_flea_mfd_reset_current(hw))
+		return BC_STS_IO_ERROR;
+	memcpy(values, observed, sizeof(observed));
+	return BC_STS_SUCCESS;
+}
+
+static BC_STATUS crystalhd_flea_mfd_reset_pair(struct crystalhd_hw *hw,
+		const char *phase)
+{
+	uint32_t first[20], second[20];
+	BC_STATUS sts;
+	unsigned int i;
+
+	sts = crystalhd_flea_mfd_reset_sample(hw, first);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	sts = crystalhd_flea_mfd_reset_sample(hw, second);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_reset_current(hw) || memcmp(first, second, sizeof(first)))
+		return BC_STS_IO_ERROR;
+	for (i = 0; i < ARRAY_SIZE(first); i++)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 mfd-reset-controls: phase=%s word=%u first=%08x second=%08x\n",
+			 phase, i, first[i], second[i]);
+	return BC_STS_SUCCESS;
+}
+
+static BC_STATUS crystalhd_flea_mfd_reset_probe(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	BC_STATUS sts;
+
+	if (!hw || hw->research_mfd_pci_isolated || hw->research_mfd_deliberate_abort ||
+	    hw->research_scl_config_dirty || hw->research_scl_reset_corroborated ||
+	    hw->research_scl_duty_generation || hw->research_scl_duty_owner ||
+	    hw->research_mfd_reset_pending || hw->research_mfd_reset_cold_sampled ||
+	    hw->research_mfd_reset_post_sampled || hw->research_mfd_reset_generation ||
+	    hw->research_mfd_reset_owner)
+		return BC_STS_BUSY;
+	sts = crystalhd_flea_scl_config_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	hw->research_mfd_pci_isolated = true;
+	pci_clear_master(hw->adp->pdev);
+	hw->research_mfd_reset_generation = generation;
+	hw->research_mfd_reset_owner = owner;
+	hw->research_mfd_reset_pending = true;
+	sts = crystalhd_flea_mfd_reset_pair(hw, "cold");
+	if (sts != BC_STS_SUCCESS) {
+		crystalhd_hw_dma_fatal_stop(hw);
+		return BC_STS_IO_ERROR;
+	}
+	hw->research_mfd_reset_cold_sampled = true;
+	dev_info(&hw->adp->pdev->dev,
+		 "issue92 mfd-reset-controls: mfd-writes=0 scl-writes=0 feed-starts=0 source-pattern-writes=0 data-reads=0 observations-only\n");
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+}
+
+/* After checked existing core reset/DDR idle, before existing powerdown.
+ * Cross-phase values may differ: no presumed defaults or completion fence.
+ */
+static BC_STATUS crystalhd_flea_mfd_reset_post(struct crystalhd_hw *hw)
+{
+	BC_STATUS sts;
+
+	if (!crystalhd_flea_mfd_reset_current(hw) ||
+	    !hw->research_mfd_reset_cold_sampled || hw->research_mfd_reset_post_sampled)
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_mfd_reset_pair(hw, "pre-clock-reset");
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	hw->research_mfd_reset_post_sampled = true;
+	return BC_STS_SUCCESS;
+}
