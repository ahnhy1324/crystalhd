+ * RDB describes the bit, not its access/restore semantics. Two literal writes
+ * are deliberately bounded; readbacks do not certify every internal master.
+ */
+static BC_STATUS crystalhd_flea_mfd_latch_probe(struct crystalhd_hw *hw,
+					     uint64_t generation, const void *owner)
+{
+	const uint32_t bit =
+		BCHP_MFD_CHROMA_SAMPLING_CNTL_CHROMA_REPOSITION_ENABLE_MASK;
+	const uint32_t error_mask = BCHP_SUN_GISB_ARB_ERR_CAP_STATUS_valid_MASK |
+		BCHP_SUN_GISB_ARB_ERR_CAP_STATUS_tea_MASK |
+		BCHP_SUN_GISB_ARB_ERR_CAP_STATUS_timeout_MASK;
+	struct crystalhd_adp *adp;
+	struct crystalhd_cmd *ctx;
+	uint32_t revision[3], sampling[3], error[3], bridge[3];
+	uint32_t opposite;
+	BC_STATUS sts = BC_STS_SUCCESS;
+
+	if (!hw || !hw->adp || !hw->adp->pdev || !owner || !generation ||
+	    !hw->pfnReadDevRegister || !hw->pfnWriteDevRegister)
+		return BC_STS_INV_ARG;
+	adp = hw->adp;
+	ctx = &adp->cmds;
+	lockdep_assert_held_write(&adp->user_lock);
+	if (!READ_ONCE(adp->present) || !adp->hw_accessible ||
+	    adp->generation != generation ||
+	    adp->pdev->device != BC_PCI_DEVID_FLEA || !adp->i2o_addr ||
+	    adp->pci_i2o_len < FLEA_GISB_INDIRECT_DATA + sizeof(uint32_t) ||
+	    ctx->adp != adp || ctx->hw_ctx != hw ||
+	    ctx->session_owner != owner || !ctx->session_module_pinned ||
+	    ctx->state != BC_LINK_INVALID || adp->cfg_users ||
+	    READ_ONCE(hw->dma_fault))
+		return BC_STS_BUSY;
+
+	revision[0] = hw->pfnReadDevRegister(adp, BCHP_MFD_REVISION_ID);
+	sampling[0] = hw->pfnReadDevRegister(adp, BCHP_MFD_CHROMA_SAMPLING_CNTL);
+	error[0] = hw->pfnReadDevRegister(adp, BCHP_SUN_GISB_ARB_ERR_CAP_STATUS);
+	bridge[0] = hw->pfnReadDevRegister(adp, BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL);
+	if (revision[0] != 0x50 || (sampling[0] & ~bit) ||
+	    (error[0] & error_mask) || (bridge[0] & ARM_RUN_REQ_BIT) ||
+	    !READ_ONCE(adp->present) || READ_ONCE(hw->dma_fault)) {
+		dev_info(&adp->pdev->dev,
+			 "issue92 mfd-latch: writes=0 admission-rejected revision=%08x sampling=%08x gisb=%08x bridge=%08x\n",
+			 revision[0], sampling[0], error[0], bridge[0]);
+		return BC_STS_IO_ERROR;
+	}
+	opposite = sampling[0] ^ bit;
+	hw->pfnWriteDevRegister(adp, BCHP_MFD_CHROMA_SAMPLING_CNTL, opposite);
+	sampling[1] = hw->pfnReadDevRegister(adp, BCHP_MFD_CHROMA_SAMPLING_CNTL);
+	revision[1] = hw->pfnReadDevRegister(adp, BCHP_MFD_REVISION_ID);
+	error[1] = hw->pfnReadDevRegister(adp, BCHP_SUN_GISB_ARB_ERR_CAP_STATUS);
+	bridge[1] = hw->pfnReadDevRegister(adp, BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL);
+	/* Always attempt literal restoration after the first attempted write,
+	 * including a mismatching readback or changed diagnostic guard.
+	 */
+	hw->pfnWriteDevRegister(adp, BCHP_MFD_CHROMA_SAMPLING_CNTL, sampling[0]);
+	sampling[2] = hw->pfnReadDevRegister(adp, BCHP_MFD_CHROMA_SAMPLING_CNTL);
+	revision[2] = hw->pfnReadDevRegister(adp, BCHP_MFD_REVISION_ID);
+	error[2] = hw->pfnReadDevRegister(adp, BCHP_SUN_GISB_ARB_ERR_CAP_STATUS);
+	bridge[2] = hw->pfnReadDevRegister(adp, BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL);
+	if (sampling[1] != opposite || sampling[2] != sampling[0] ||
+	    revision[1] != 0x50 || revision[2] != 0x50 ||
+	    ((error[1] | error[2]) & error_mask) ||
+	    ((bridge[1] | bridge[2]) & ARM_RUN_REQ_BIT) ||
+	    !READ_ONCE(adp->present) || READ_ONCE(hw->dma_fault))
+		sts = BC_STS_IO_ERROR;
+	dev_info(&adp->pdev->dev,
+		 "issue92 mfd-latch: writes=2 status=%u sampling=%08x/%08x/%08x expected-toggle=%08x revision=%08x/%08x/%08x gisb=%08x/%08x/%08x bridge=%08x/%08x/%08x\n",
+		 sts, sampling[0], sampling[1], sampling[2], opposite,
+		 revision[0], revision[1], revision[2], error[0], error[1], error[2],
+		 bridge[0], bridge[1], bridge[2]);
+	return sts;
+}
