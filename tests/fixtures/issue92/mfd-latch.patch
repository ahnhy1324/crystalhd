+static void mfd_admission_results(void)
+{
+	groups++;
+	reset();
+	hardware.research_mfd_latch_probe = true;
+	check(crystalhd_flea_download_fw(&hardware,
+	      (const uint8_t *)firmware.words, sizeof(firmware.words)) ==
+	      BC_STS_INV_ARG && no_effects() && !mfd_calls &&
+	      !hardware.research_mfd_latch_probe &&
+	      !hardware.research_mfd_generation && !hardware.research_mfd_owner,
+	      "MFD without staging rejects before effects and consumes all private fields");
+	for (unsigned int fault = 0; fault < 10; fault++) {
+		const uint8_t *buffer;
+
+		reset();
+		hardware.research_staging_probe = true;
+		hardware.research_mfd_latch_probe = true;
+		buffer = (const uint8_t *)firmware.words;
+		switch (fault) {
+		case 0: buffer = NULL; break;
+		case 1: buffer++; break;
+		case 2: hardware.adp = NULL; break;
+		case 3: adapter.pdev = NULL; break;
+		case 4: hardware.pfnReadDevRegister = NULL; break;
+		case 5: hardware.pfnWriteDevRegister = NULL; break;
+		case 6: hardware.pfnDevDRAMWrite = NULL; break;
+		case 7: hardware.pfnDevDRAMRead = NULL; break;
+		case 8: hardware.research_mfd_generation = 0; break;
+		case 9: hardware.research_mfd_owner = NULL; break;
+		}
+		check(crystalhd_flea_download_fw(&hardware, buffer,
+		      sizeof(firmware.words)) == BC_STS_INV_ARG && no_effects() &&
+		      !mfd_calls && !hardware.research_staging_probe &&
+		      !hardware.research_mfd_latch_probe &&
+		      !hardware.research_mfd_generation && !hardware.research_mfd_owner,
+		      "early downloader rejection consumes all one-shot MFD fields without MMIO");
+	}
+	for (unsigned int fault = 0; fault < 21; fault++) {
+		struct crystalhd_hw *hw;
+		u64 generation;
+		const void *owner;
+
+		reset();
+		hw = &hardware;
+		generation = adapter.generation;
+		owner = &research_owner;
+		switch (fault) {
+		case 0: hw = NULL; break;
+		case 1: hardware.adp = NULL; break;
+		case 2: adapter.pdev = NULL; break;
+		case 3: hardware.pfnReadDevRegister = NULL; break;
+		case 4: hardware.pfnWriteDevRegister = NULL; break;
+		case 5: adapter.cmds.hw_ctx = NULL; break;
+		case 6: adapter.cmds.adp = NULL; break;
+		case 7: adapter.present = 0; break;
+		case 8: adapter.hw_accessible = false; break;
+		case 9: generation ^= 1ULL; break;
+		case 10: pci.device = 0x1612; break;
+		case 11: adapter.cfg_users = 1; break;
+		case 12: adapter.i2o_addr = NULL; break;
+		case 13: adapter.pci_i2o_len = 0xffff; break;
+		case 14: owner = NULL; break;
+		case 15: owner = &firmware; break;
+		case 16: adapter.cmds.session_owner = NULL; break;
+		case 17: adapter.cmds.session_module_pinned = false; break;
+		case 18: adapter.cmds.state = 1; break;
+		case 19: hardware.dma_fault = true; break;
+		case 20: generation = 0; break;
+		}
+		check(crystalhd_flea_mfd_latch_probe(hw, generation, owner) !=
+		      BC_STS_SUCCESS && no_effects() && !mfd_access_count &&
+		      state_unchanged(),
+		      "every failed MFD context/ownership admission rejects before MMIO");
+	}
+}
