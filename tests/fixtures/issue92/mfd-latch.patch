+static BC_STATUS run_mfd_download(void)
+{
+	hardware.research_staging_probe = true;
+	hardware.research_mfd_latch_probe = true;
+	return crystalhd_flea_download_fw(&hardware,
+		(const uint8_t *)firmware.words, sizeof(firmware.words));
+}
+
+static void check_mfd_accesses(unsigned int expected_writes)
+{
+	unsigned int writes = 0;
+
+	for (unsigned int n = 0; n < mfd_access_count; n++) {
+		const struct mfd_access *access = &mfd_accesses[n];
+
+		if (access->write) {
+			check(access->offset == BCHP_MFD_CHROMA_SAMPLING_CNTL &&
+			      access->value == (writes ? mfd_initial : mfd_initial ^ 1U),
+			      "only opposite-literal and original-literal writes are admitted");
+			writes++;
+		} else {
+			check(access->offset == BCHP_SUN_GISB_ARB_ERR_CAP_STATUS ||
+			      access->offset == BCHP_MFD_REVISION_ID ||
+			      access->offset == BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL ||
+			      access->offset == BCHP_MFD_CHROMA_SAMPLING_CNTL,
+			      "each MFD observation uses the fixed guard or target address");
+		}
+		check(access->offset != BCHP_SUN_GISB_ARB_ERR_CAP_CLR,
+		      "MFD probe never reads or writes the error-clear register");
+	}
+	check(writes == expected_writes && mfd_target_writes == expected_writes,
+	      "the MFD probe performs the exact expected number of target writes");
+	check(!memcmp(&firmware, &firmware_before, sizeof(firmware)),
+	      "the MFD probe never changes the pinned host firmware image");
+}
