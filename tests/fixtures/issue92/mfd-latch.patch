+static void mfd_register_admission_results(void)
+{
+	static const uint32_t bad_revisions[] = { 0, 0x51, 0x10050, UINT32_MAX };
+	static const uint32_t bad_targets[] = { 2, 3, 0x80000000, UINT32_MAX };
+	static const uint32_t error_bits[] = { 1, 0x800, 0x1000 };
+
+	groups++;
+	check(BCHP_MFD_REVISION_ID == 0x540000 &&
+	      BCHP_MFD_CHROMA_SAMPLING_CNTL == 0x540024 &&
+	      BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL == 0xe0004 &&
+	      BCHP_SUN_GISB_ARB_ERR_CAP_STATUS == 0x4000d4 &&
+	      ARM_RUN_REQ_BIT == 2,
+	      "RDB declarations bind each MFD target and guard to its fixed address");
+	for (unsigned int n = 0; n < sizeof(bad_revisions) / sizeof(bad_revisions[0]); n++) {
+		reset();
+		mfd_revision_by_stage[0] = bad_revisions[n];
+		check(crystalhd_flea_mfd_latch_probe(&hardware, adapter.generation,
+		      &research_owner) != BC_STS_SUCCESS && !dev_writes &&
+		      !mfd_target_writes && state_unchanged(),
+		      "zero, unexpected and reserved revision values reject before target writes");
+		check_mfd_accesses(0);
+	}
+	for (unsigned int n = 0; n < sizeof(bad_targets) / sizeof(bad_targets[0]); n++) {
+		reset();
+		mfd_current = bad_targets[n];
+		check(crystalhd_flea_mfd_latch_probe(&hardware, adapter.generation,
+		      &research_owner) != BC_STS_SUCCESS && !dev_writes &&
+		      !mfd_target_writes && state_unchanged(),
+		      "target values containing any reserved bit reject before writes");
+		check_mfd_accesses(0);
+	}
+	for (unsigned int n = 0; n < sizeof(error_bits) / sizeof(error_bits[0]); n++) {
+		reset();
+		mfd_error_fail_at = 1;
+		mfd_error_fail_value = error_bits[n];
+		check(crystalhd_flea_mfd_latch_probe(&hardware, adapter.generation,
+		      &research_owner) != BC_STS_SUCCESS && !dev_writes &&
+		      !mfd_target_writes && state_unchanged(),
+		      "valid, TEA or timeout captured before a write stops the probe");
+		check_mfd_accesses(0);
+	}
+	reset();
+	mfd_bridge_by_stage[0] = ARM_RUN_REQ_BIT;
+	check(crystalhd_flea_mfd_latch_probe(&hardware, adapter.generation,
+	      &research_owner) != BC_STS_SUCCESS && !dev_writes &&
+	      !mfd_target_writes && state_unchanged(),
+	      "an initially asserted ARM request prevents any target write");
+	check_mfd_accesses(0);
+	for (unsigned int fault = 0; fault < 6; fault++) {
+		reset();
+		if (fault == 0)
+			mfd_revision_by_stage[0] = 0;
+		else if (fault == 1)
+			mfd_current = 2;
+		else if (fault < 5)
+			mfd_error_by_stage[0] = error_bits[fault - 2];
+		else
+			mfd_bridge_by_stage[0] = ARM_RUN_REQ_BIT;
+		check(run_mfd_download() == BC_STS_IO_ERROR && mfd_calls == 1 &&
+		      !mfd_target_writes && !cmac_writes && !arm_run_writes &&
+		      !heartbeats && !hardware.research_staging_probe &&
+		      !hardware.research_mfd_latch_probe &&
+		      !hardware.research_mfd_generation && !hardware.research_mfd_owner,
+		      "initial MFD register admission faults prevent authentication and start");
+		check_mfd_accesses(0);
+	}
+}
+
+static void mfd_latch_results(void)
+{
+	static const uint32_t error_bits[] = { 1, 0x800, 0x1000 };
+
+	groups++;
+	reset();
+	for (unsigned int n = 0; n < 3; n++) {
+		mfd_error_by_stage[n] = 0x2;
+		mfd_bridge_by_stage[n] = 0x4;
+	}
+	check(crystalhd_flea_mfd_latch_probe(&hardware, adapter.generation,
+	      &research_owner) == BC_STS_SUCCESS && mfd_target_writes == 2 &&
+	      mfd_current == mfd_initial,
+	      "unmasked diagnostic bits do not change the fixed error/run admission masks");
+	check_mfd_accesses(2);
+	for (unsigned int original = 0; original < 2; original++) {
+		reset();
+		mfd_initial = mfd_current = original;
+		check(run_mfd_download() == BC_STS_SUCCESS && mfd_calls == 1 &&
+		      mfd_target_reads == 3 && mfd_target_writes == 2 &&
+		      mfd_current == original && cmac_writes == 4 &&
+		      arm_run_writes == 1 && heartbeats == 1 &&
+		      !hardware.research_staging_probe &&
+		      !hardware.research_mfd_latch_probe &&
+		      !hardware.research_mfd_generation && !hardware.research_mfd_owner &&
+		      !memcmp(card_prefix, expected_image, sizeof(card_prefix)) &&
+		      card_suffix == expected_image[24],
+		      "both 0-to-1-to-0 and 1-to-0-to-1 probes restore and authenticate normally");
+		check_mfd_accesses(2);
+		check(mfd_error_reads == 3 && mfd_revision_reads == 3 &&
+		      mfd_bridge_reads == 3,
+		      "successful probe observes all initial, post-write and post-restore guards");
+		dram_writes = dram_reads = bridge_reads = 0;
+		cmac_writes = arm_run_writes = heartbeats = flea_status_reads = 0;
+		check(crystalhd_flea_download_fw(&hardware,
+		      (const uint8_t *)firmware.words, sizeof(firmware.words)) ==
+		      BC_STS_SUCCESS && mfd_calls == 1 && mfd_target_writes == 2,
+		      "a second download cannot replay the consumed MFD probe flag");
+	}
+	for (unsigned int stage = 1; stage < 3; stage++) {
+		for (unsigned int fault = 0; fault < 6; fault++) {
+			reset();
+			if (fault == 0) {
+				mfd_toggle_mismatch = stage == 1;
+				mfd_restore_mismatch = stage == 2;
+			} else if (fault <= 3) {
+				mfd_error_by_stage[stage] = error_bits[fault - 1];
+			} else if (fault == 4) {
+				mfd_revision_by_stage[stage] = 0;
+			} else {
+				mfd_bridge_by_stage[stage] = ARM_RUN_REQ_BIT;
+			}
+			check(run_mfd_download() != BC_STS_SUCCESS && mfd_calls == 1 &&
+			      mfd_target_writes == 2 && mfd_current == mfd_initial &&
+			      !cmac_writes && !arm_run_writes && !heartbeats &&
+			      !hardware.research_staging_probe &&
+			      !hardware.research_mfd_latch_probe &&
+			      !hardware.research_mfd_generation && !hardware.research_mfd_owner &&
+			      !memcmp(&firmware, &firmware_before, sizeof(firmware)) &&
+			      !memcmp(card_prefix, expected_image, sizeof(card_prefix)) &&
+			      card_suffix == expected_image[24],
+			      "post-write/restore mismatch or guard fault always restores and prevents CMAC/start");
+			check_mfd_accesses(2);
+		}
+	}
+}
