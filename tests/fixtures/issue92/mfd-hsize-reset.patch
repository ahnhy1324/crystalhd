+/* Same bounded register observations as #236; this label distinguishes the
+ * configuration contrast. Report a complete equal pair before classifying
+ * its relationship to the saved tuple. Never read a pixel/debug DATA port.
+ */
+static BC_STATUS crystalhd_flea_mfd_hsize_pair(struct crystalhd_hw *hw,
+		const char *phase, uint32_t *values)
+{
+	uint32_t first[20], second[20];
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (!values)
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_mfd_reset_sample(hw, first);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	sts = crystalhd_flea_mfd_reset_sample(hw, second);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_reset_current(hw) || memcmp(first, second, sizeof(first)))
+		return BC_STS_IO_ERROR;
+	for (i = 0; i < ARRAY_SIZE(first); i++)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 mfd-hsize-reset: phase=%s word=%u first=%08x second=%08x\n",
+			 phase, i, first[i], second[i]);
+	memcpy(values, first, sizeof(first));
+	return BC_STS_SUCCESS;
+}
+
+/* One defined-field configuration write, not an active source experiment.
+ * The saved observation and retained dirty duty do not certify source
+ * ownership, fetch extent, all-consumer quiescence or a pixel/output route.
+ */
+static BC_STATUS crystalhd_flea_mfd_hsize_probe(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	uint32_t cold[20], request[20], expected[20];
+	BC_STATUS sts;
+
+	if (!hw || hw->research_mfd_pci_isolated || hw->research_mfd_deliberate_abort ||
+	    hw->research_scl_config_dirty || hw->research_scl_reset_corroborated ||
+	    hw->research_scl_duty_generation || hw->research_scl_duty_owner ||
+	    hw->research_mfd_reset_pending || hw->research_mfd_reset_cold_sampled ||
+	    hw->research_mfd_reset_post_sampled || hw->research_mfd_reset_generation ||
+	    hw->research_mfd_reset_owner || hw->research_mfd_hsize_dirty ||
+	    hw->research_mfd_hsize_request_sampled || hw->research_mfd_hsize_reset_corroborated)
+		return BC_STS_BUSY;
+	sts = crystalhd_flea_scl_config_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	hw->research_mfd_pci_isolated = true;
+	pci_clear_master(hw->adp->pdev);
+	hw->research_mfd_reset_generation = generation;
+	hw->research_mfd_reset_owner = owner;
+	hw->research_mfd_reset_pending = true;
+	sts = crystalhd_flea_mfd_hsize_pair(hw, "cold", cold);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	hw->research_mfd_reset_cold_sampled = true;
+	/* Exact observed raw admission, not a claimed unit or silicon default. */
+	if (cold[5] != 0x780)
+		return BC_STS_BUSY; /* No configuration write or dirty duty yet. */
+	memcpy(hw->research_mfd_hsize_saved, cold, sizeof(cold));
+	memcpy(expected, cold, sizeof(cold));
+	expected[5] = 4;
+	/* Arm before the void write callback, even if its effect is unreadable. */
+	hw->research_mfd_hsize_dirty = true;
+	if (!crystalhd_flea_mfd_reset_current(hw))
+		goto quarantine;
+	hw->pfnWriteDevRegister(hw->adp, BCHP_MFD_DISP_HSIZE, 4);
+	if (!crystalhd_flea_mfd_reset_current(hw))
+		goto quarantine;
+	sts = crystalhd_flea_mfd_hsize_pair(hw, "request", request);
+	if (sts != BC_STS_SUCCESS || memcmp(request, expected, sizeof(request)) ||
+	    !crystalhd_flea_mfd_reset_current(hw))
+		goto quarantine;
+	hw->research_mfd_hsize_request_sampled = true;
+	dev_info(&hw->adp->pdev->dev,
+		 "issue92 mfd-hsize-reset: mfd-writes=1 target=00540014 value=00000004 scl-writes=0 feed-starts=0 source-pattern-writes=0 data-reads=0 dirty-duty=retained\n");
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+
+quarantine:
+	crystalhd_hw_dma_fatal_stop(hw);
+	return BC_STS_IO_ERROR;
+}
