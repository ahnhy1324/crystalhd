+	if (!crystalhd_flea_mfd_reset_current(hw) || !hw->research_mfd_hsize_dirty ||
+	    !hw->research_mfd_reset_cold_sampled || hw->research_mfd_reset_post_sampled ||
+	    !hw->research_mfd_hsize_request_sampled || hw->research_mfd_hsize_reset_corroborated)
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_mfd_hsize_pair(hw, "pre-clock-reset", post);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (memcmp(post, hw->research_mfd_hsize_saved, sizeof(post)) ||
+	    !crystalhd_flea_mfd_reset_current(hw)) {
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 mfd-hsize-reset: original-tuple=no dirty-duty=retained\n");
+		return BC_STS_IO_ERROR;
+	}
+	hw->research_mfd_reset_post_sampled = true;
+	hw->research_mfd_hsize_reset_corroborated = true;
+	dev_info(&hw->adp->pdev->dev,
+		 "issue92 mfd-hsize-reset: original-tuple=yes dirty-duty=retained awaiting-complete-stock-stop\n");
+	return BC_STS_SUCCESS;
+}
