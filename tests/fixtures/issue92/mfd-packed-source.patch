+static void packed_register_results(void)
+{
+	groups++;
+	reset_packed(1);packed_oracle(UINT32_MAX,0);
+	struct packed_event normal[1024];const unsigned total=packed_expected_count;
+	memcpy(normal,packed_expected,total*sizeof(*normal));
+	/* Independent RDB reserved masks and expected-value comparisons. A clean
+	 * raw sample does not imply that the MFD fetched our source pattern.
+	 */
+	for(unsigned event=1;event<=total;event++)if(normal[event-1].kind=='R') {
+		const uint32_t address=normal[event-1].address;
+		uint32_t reject=0;
+		switch(address) {
+		case 0x540000:case 0x54001c:case 0x540004:case 0x540010:case 0x540074:case 0x540030:
+		case 0x540014:case 0x540018:case 0x54000c:case 0x540024:case 0x540044:case 0x54007c:
+			reject=UINT32_MAX;break;
+		case 0x4000d4:reject=0x1801;break;
+		case 0xe0004:reject=2;break;
+		case 0x540064:reject=0xfd000000;break;
+		case 0x540078:reject=0xfc000000;break;
+		case 0x540080:reject=0xf0000000;break;
+		case 0x540050:reject=0xdfffe000;break;
+		case 0x540070:reject=0xfffffffc;break;
+		case 0x54006c:reject=0xfffffff8;break;
+		default:check(false,"literal reserved oracle covers every fixed read target");
+		}
+		for(unsigned bit=0;bit<32;bit++)if(reject & (1U<<bit)) {
+			if(event==10 && bit==2)continue; /* Initial saturation0/4 is admitted. */
+			/* Post-pulse raw9 XOR1 =8 is explicitly admitted only here. */
+			if(address==0x540074 && normal[event-1].value==9 && bit==0)continue;
+			reset_packed(1);packed_fault_at=event;packed_fault_value=normal[event-1].value^(1U<<bit);
+			/* The initial setup-only reads admit their RDB-defined bits. */
+			if(event>=11 && event<=18) {
+				const uint32_t setup_reserved[]={0xffffe000,0xe000e000,0xfffff820,0xfffffffe,
+				                               0xfffffffe,0xfffffff0,0xfffffff0,0xfffffff0};
+				if(!(setup_reserved[event-11] & (1U<<bit)))continue;
+			}
+			const BC_STATUS status=run_packed();
+			const bool stopped=status!=BC_STS_CMD_CANCELLED && packed_count==event &&
+			      packed_writes==packed_writes_at_fault && !hardware.research_mfd_deliberate_abort;
+			check(stopped,"each exact-profile or reserved bit mismatch stops at its measured scalar, never masking or retrying");
+		}
+	}
+	/* Defined nonzero feed/BVB/sync observations stay opaque; no address follow. */
+	const uint32_t admitted[][2]={{0x540078,0x03ffffff},{0x540080,0x0fffffff},
+	                            {0x540050,0x20001fff},{0x540070,3}};
+	for(unsigned n=0;n<ARRAY_SIZE(admitted);n++) {
+		reset_packed(1);unsigned event=0;
+		for(unsigned k=0;k<total;k++)if(normal[k].kind=='R' && normal[k].address==admitted[n][0]){event=k+1;break;}
+		packed_fault_at=event;packed_fault_value=admitted[n][1];
+		check(event && run_packed()==BC_STS_CMD_CANCELLED && packed_count==total && packed_writes==42 &&
+		      !fatal_stops,"defined raw observation bits may vary without becoming pointers or source/fetch proof");
+	}
