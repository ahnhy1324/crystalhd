@@ -1387,6 +1387,201 @@ static BC_STATUS crystalhd_flea_mfd_scl_sample(struct crystalhd_hw *hw,
  * valid guards. It adds one pre-START baseline and <=17 active raw tuples,
  * not a pixel, routing, clock/idle or completion certificate.
  */
+/* This is an empirical zero-address namespace hypothesis, NOT a source lease.
+ * PCI isolation does not certify local fetch extent, downstream effects or
+ * reset coverage. Bounds below constrain host actions only. The first 16 bytes
+ * are nominal packed 8x1 input; the other 80 bytes are padding, not a fetch bound.
+ * Never restore this live prefix, authenticate it or run firmware afterwards.
+ */
+static BC_STATUS crystalhd_flea_mfd_packed_guard(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, uint32_t ctrl,
+		uint32_t stride, uint32_t test)
+{
+	BC_STATUS sts;
+	uint32_t test_raw;
+
+	if (!hw || !hw->adp || !hw->adp->mem_addr ||
+	    hw->adp->pci_mem_len <
+	    ~BCHP_MISC2_DIRECT_WINDOW_CONTROL_DIRECT_WINDOW_BASE_ADDR_MASK + 1U)
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (hw->pfnReadDevRegister(hw->adp, BCHP_MFD_PICTURE0_LINE_ADDR_0) != 0 ||
+	    hw->pfnReadDevRegister(hw->adp, BCHP_MFD_FEEDER_CNTL) != ctrl ||
+	    hw->pfnReadDevRegister(hw->adp, BCHP_MFD_STRIDE) != stride)
+		return BC_STS_IO_ERROR;
+	test_raw = hw->pfnReadDevRegister(hw->adp, BCHP_MFD_TEST_MODE_CNTL);
+	/* Only after the one planned W9 attempt may PULSE have self-cleared.
+	 * No latch/edge semantics are certified and raw8 never causes a retry.
+	 */
+	if (test == 9)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 packed-source: post-pulse-attempt test=%08x admitted=8-or-9 latch/edge-unproved=yes\n", test_raw);
+	if ((test_raw != test && !(test == 9 && test_raw == 8)) ||
+	    !READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault) ||
+	    hw->adp->generation != generation || hw->adp->cmds.session_owner != owner)
+		return BC_STS_IO_ERROR;
+	return BC_STS_SUCCESS;
+}
+
+static BC_STATUS crystalhd_flea_mfd_packed_probe(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, uint32_t selector)
+{
+	static const uint32_t patterns[2][24] = {
+		{ 0xaa425531, 0xbb646653, 0xcc867775, 0xdda88897,
+		  0x12121212, 0x12121212, 0x12121212, 0x12121212,
+		  0x12121212, 0x12121212, 0x12121212, 0x12121212,
+		  0x12121212, 0x12121212, 0x12121212, 0x12121212,
+		  0x12121212, 0x12121212, 0x12121212, 0x12121212,
+		  0x12121212, 0x12121212, 0x12121212, 0x12121212 },
+		{ 0x55bdaace, 0x449b99ac, 0x3379888a, 0x22577768,
+		  0xedededed, 0xedededed, 0xedededed, 0xedededed,
+		  0xedededed, 0xedededed, 0xedededed, 0xedededed,
+		  0xedededed, 0xedededed, 0xedededed, 0xedededed,
+		  0xedededed, 0xedededed, 0xedededed, 0xedededed,
+		  0xedededed, 0xedededed, 0xedededed, 0xedededed },
+	};
+	/* STRIDE zero is reserved-bit-clean in both RDB unions, not a certified
+	 * operational stride or unit. Configure it while CTRL is
+	 * still zero. PACKED CTRL=5 is last. No FIXED/LINE0/LINE1 write exists.
+	 */
+	const struct { uint32_t address, value, mask; } controls[] = {
+		{ BCHP_MFD_STRIDE, 0, 0xffffffff },
+		{ BCHP_MFD_DISP_HSIZE, 8, 0x1fff },
+		{ BCHP_MFD_PICTURE0_DISP_VERT_WINDOW, 0, 0x1fff1fff },
+		{ BCHP_MFD_LAC_CNTL, 3, 0x7df },
+		{ BCHP_MFD_CHROMA_SAMPLING_CNTL, 0, 1 },
+		{ BCHP_MFD_DATA_MODE, 0, 1 },
+		{ BCHP_MFD_TEST_PORT_CNTL, 15, 15 },
+		{ BCHP_MFD_TEST_MODE_CNTL, 8, 15 },
+		{ BCHP_MFD_FEEDER_CNTL, 5, 15 },
+	};
+	struct crystalhd_adp *adp;
+	uint32_t observed[24], stride, test, ctrl = 0;
+	uint32_t sample, tap, feed, bvb, feeder;
+	unsigned int i, pulses = 0;
+	BC_STATUS sts;
+
+	if (selector < 1 || selector > 2 || !hw || !hw->pfnDevDRAMWrite ||
+	    !hw->pfnDevDRAMRead || !hw->adp || !hw->adp->mem_addr ||
+	    hw->adp->pci_mem_len <
+	    ~BCHP_MISC2_DIRECT_WINDOW_CONTROL_DIRECT_WINDOW_BASE_ADDR_MASK + 1U)
+		return BC_STS_INV_ARG;
+	if (hw->research_mfd_pci_isolated || hw->research_mfd_deliberate_abort)
+		return BC_STS_BUSY;
+	sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	adp = hw->adp;
+	if (hw->pfnReadDevRegister(adp, BCHP_MFD_PIC_FEED_CMD) != 0 ||
+	    hw->pfnReadDevRegister(adp, BCHP_MFD_PICTURE0_LINE_ADDR_0) != 0 ||
+	    hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_CNTL) != 0 ||
+	    hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS) != 0)
+		return BC_STS_BUSY;
+	stride = hw->pfnReadDevRegister(adp, BCHP_MFD_STRIDE);
+	if (stride != 0 && stride != 0x00800080)
+		return BC_STS_BUSY;
+	test = hw->pfnReadDevRegister(adp, BCHP_MFD_TEST_MODE_CNTL);
+	if (test != 0 && test != 4)
+		return BC_STS_BUSY;
+	for (i = 1; i < ARRAY_SIZE(controls); i++)
+		if (hw->pfnReadDevRegister(adp, controls[i].address) & ~controls[i].mask)
+			return BC_STS_IO_ERROR;
+	hw->research_mfd_pci_isolated = true; /* Before the attempted PCI update. */
+	pci_clear_master(adp->pdev);
+	sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	sts = hw->pfnDevDRAMWrite(hw, FW_DOWNLOAD_START_ADDR, 24, patterns[selector - 1]);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	sts = hw->pfnDevDRAMRead(hw, FW_DOWNLOAD_START_ADDR, 24, observed);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	if (memcmp(observed, patterns[selector - 1], sizeof(observed)))
+		goto mismatch;
+	dev_info(&adp->pdev->dev,
+		 "issue92 packed-source: pattern=%u prefix=96 nominal=16 padding=80 word0=%08x word1=%08x word2=%08x word3=%08x padding-last=%08x namespace/stride/fetch-extent-unproved=yes master=0\n",
+		 selector, observed[0], observed[1], observed[2], observed[3], observed[23]);
+	for (i = 0; i < ARRAY_SIZE(controls); i++) {
+		sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+		if (sts != BC_STS_SUCCESS)
+			goto quarantine;
+		hw->pfnWriteDevRegister(adp, controls[i].address, controls[i].value);
+		if (!READ_ONCE(adp->present) || READ_ONCE(hw->dma_fault) ||
+		    adp->generation != generation || adp->cmds.session_owner != owner)
+			goto mismatch;
+		if (hw->pfnReadDevRegister(adp, controls[i].address) != controls[i].value)
+			goto mismatch;
+		if (i == 0) stride = 0;
+		if (i == 7) test = 8;
+		if (i == 8) ctrl = 5;
+	}
+	sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	sample = hw->pfnReadDevRegister(adp, BCHP_MFD_BVB_SAMPLE_DATA);
+	if (sample & 0xfc000000)
+		goto mismatch;
+	tap = hw->pfnReadDevRegister(adp, BCHP_MFD_TEST_PORT_DATA);
+	if (tap & 0xf0000000)
+		goto mismatch;
+	dev_info(&adp->pdev->dev, "issue92 packed-source: pre-start sample=%08x tap=%08x\n", sample, tap);
+	sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	hw->pfnWriteDevRegister(adp, BCHP_MFD_PIC_FEED_CMD, 1);
+	for (i = 0; i <= 16; i++) {
+		sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+		if (sts != BC_STS_SUCCESS)
+			goto quarantine;
+		sample = hw->pfnReadDevRegister(adp, BCHP_MFD_BVB_SAMPLE_DATA);
+		if (sample & 0xfc000000) goto mismatch;
+		tap = hw->pfnReadDevRegister(adp, BCHP_MFD_TEST_PORT_DATA);
+		if (tap & 0xf0000000) goto mismatch;
+		feed = hw->pfnReadDevRegister(adp, BCHP_MFD_FEED_STATUS);
+		if (feed & (BCHP_MFD_FEED_STATUS_reserved0_MASK |
+			    BCHP_MFD_FEED_STATUS_reserved1_MASK)) goto mismatch;
+		bvb = hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_BVB_STATUS);
+		if (bvb & ~3U) goto mismatch;
+		feeder = hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS);
+		if (feeder & ~7U) goto mismatch;
+		dev_info(&adp->pdev->dev,
+			 "issue92 packed-source: observation=%u host-pulses=%u sample=%08x tap=%08x feed=%08x bvb=%08x feeder=%08x READY-is-not-ACCEPT=yes\n",
+			 i, pulses, sample, tap, feed, bvb, feeder);
+		if (i == 16 || feeder)
+			break;
+		sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+		if (sts != BC_STS_SUCCESS) goto quarantine;
+		hw->pfnWriteDevRegister(adp, BCHP_MFD_TEST_MODE_CNTL, 9);
+		test = 9;
+		udelay(10);
+		sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+		if (sts != BC_STS_SUCCESS) goto quarantine;
+		hw->pfnWriteDevRegister(adp, BCHP_MFD_TEST_MODE_CNTL, 8);
+		test = 8;
+		pulses++;
+		udelay(10);
+	}
+	sts = crystalhd_flea_mfd_packed_guard(hw, generation, owner, ctrl, stride, test);
+	if (sts != BC_STS_SUCCESS) goto quarantine;
+	dev_info(&adp->pdev->dev,
+		 "issue92 packed-source: summary observations=%u host-pulses=%u writes=%u observed-status-bits=%08x diagnostic=%s source-correspondence=UNPROVED\n",
+		 i + 1, pulses, 10 + 2 * pulses, feeder, feeder ? "FAIL" : "INCONCLUSIVE");
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+mismatch:
+	sts = BC_STS_IO_ERROR;
+quarantine:
+	crystalhd_hw_dma_fatal_stop(hw);
+	return sts;
+}
