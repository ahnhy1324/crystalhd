+struct packed_gate_result { int status; };
+static void packed_version_gate(unsigned selector,unsigned nonstate,struct packed_gate_result *result)
+{
+	const struct crystalhd_fw_research_request request_value={.selector=selector};
+	const struct crystalhd_fw_research_request *request=&request_value;
+	const void *state=(nonstate & 1)?&hardware:NULL;
+	const void *controller=(nonstate & 2)?&hardware:NULL;
+	const void *image=(nonstate & 4)?&hardware:NULL;
+	const void *packet=(nonstate & 8)?&hardware:NULL;
+	const void *heap_packet=(nonstate & 16)?&hardware:NULL;
+	const void *clock=(nonstate & 32)?&hardware:NULL;
+	const void *uart=(nonstate & 64)?&hardware:NULL;
+	result->status=0;
+#define CRYSTALHD_MFD_PACKED_SOURCE_PROBE
+#include "packed-version-gate.h"
+#undef CRYSTALHD_MFD_PACKED_SOURCE_PROBE
+}
+
+static void packed_scope_results(void)
+{
+	groups++;
+	for(unsigned selector=0;selector<=12;selector++)for(unsigned nonstate=0;nonstate<128;nonstate++) {
+		struct packed_gate_result result={123};
+		packed_version_gate(selector,nonstate,&result);
+		check(result.status==(selector==1 && !nonstate?0:-EINVAL),
+		      "actual extracted packed opt-in gate permits only VERSION without state/decoder/clock/UART routes");
+	}
+	struct packed_gate_result result={123};
+	packed_version_gate(UINT32_MAX,0,&result);
+	check(result.status==-EINVAL,"invalid high selector cannot bypass new module VERSION-only scope");
+}
