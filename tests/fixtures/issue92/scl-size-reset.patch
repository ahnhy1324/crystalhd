+/* Fixed empirical profiles, not pixel units or reset specifications. TOP
+ * picture-boundary policy is not proof that a size write is only a shadow.
+ */
+static BC_STATUS crystalhd_flea_scl_size_sample(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, const uint32_t *sizes,
+		uint32_t *values)
+{
+	uint32_t expected[14] = {
+		0x80, 0x0c, 0, 0, 0x02d000f0, 0, 0x02d000f0,
+		0x02d000f0, 0, 0, 0, 0, 0x03000000, 0x80,
+	};
+	BC_STATUS sts;
+
+	if (!sizes || !values)
+		return BC_STS_INV_ARG;
+	expected[4] = sizes[0];
+	expected[6] = sizes[1];
+	expected[7] = sizes[2];
+	sts = crystalhd_flea_scl_config_sample(hw, generation, owner, values);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	/* Opaque coarse words have no reserved mask in the read-only profile.
+	 * This fixed write experiment refuses all-ones there without publishing
+	 * that transport-failure pattern as a qualified raw mismatch.
+	 */
+	if (values[11] == 0xffffffff || values[12] == 0xffffffff)
+		return BC_STS_IO_ERROR;
+	if (memcmp(values, expected, sizeof(expected))) {
+		unsigned int i;
+
+		/* Only a complete current, reserved-clean tuple reaches this log.
+		 * A refusal records evidence; it never licenses retry or restoration.
+		 */
+		for (i = 0; i < ARRAY_SIZE(expected); i++)
+			if (values[i] != expected[i])
+				dev_info(&hw->adp->pdev->dev,
+					 "issue92 scl-size-reset: guard-reject word=%u expected=%08x observed=%08x complete-tuple=1\n",
+					 i, expected[i], values[i]);
+		return BC_STS_IO_ERROR;
+	}
+	return BC_STS_SUCCESS;
+}
+
+static bool crystalhd_flea_scl_size_current(struct crystalhd_hw *hw)
+{
+	return hw && hw->adp && hw->adp->pdev &&
+		hw->pfnReadDevRegister && hw->pfnWriteDevRegister &&
+		hw->research_scl_config_dirty && hw->research_scl_duty_generation &&
+		hw->research_scl_duty_owner && hw->research_mfd_pci_isolated &&
+		READ_ONCE(hw->adp->present) && hw->adp->hw_accessible &&
+		!READ_ONCE(hw->dma_fault) &&
+		hw->adp->generation == hw->research_scl_duty_generation &&
+		hw->adp->cmds.hw_ctx == hw &&
+		hw->adp->cmds.session_module_pinned &&
+		hw->adp->cmds.session_owner == hw->research_scl_duty_owner;
+}
+
+/* No TOP/ENABLE/START, DATA-port, coefficient or source-pattern operation.
+ * Duty precedes the first attempted size write, including ambiguous failure.
+ */
+static BC_STATUS crystalhd_flea_scl_size_reset_probe(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	static const uint32_t addresses[3] = {
+		BCHP_SCL_HD_BVB_IN_SIZE, BCHP_SCL_HD_SRC_PIC_SIZE, BCHP_SCL_HD_DEST_PIC_SIZE,
+	};
+	uint32_t sizes[3] = { 0x02d000f0, 0x02d000f0, 0x02d000f0 };
+	uint32_t first[14], second[14], value;
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (hw && (hw->research_mfd_pci_isolated || hw->research_mfd_deliberate_abort ||
+	    hw->research_scl_config_dirty || hw->research_scl_reset_corroborated ||
+	    hw->research_scl_duty_generation || hw->research_scl_duty_owner))
+		return BC_STS_BUSY;
+	sts = crystalhd_flea_scl_config_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	hw->research_mfd_pci_isolated = true;
+	pci_clear_master(hw->adp->pdev);
+	sts = crystalhd_flea_scl_size_sample(hw, generation, owner, sizes, first);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	sts = crystalhd_flea_scl_size_sample(hw, generation, owner, sizes, second);
+	if (sts != BC_STS_SUCCESS || memcmp(first, second, sizeof(first)))
+		goto quarantine;
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		goto quarantine;
+	hw->research_scl_duty_generation = generation;
+	hw->research_scl_duty_owner = owner;
+	hw->research_scl_reset_corroborated = false;
+	hw->research_scl_config_dirty = true;
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		if (!crystalhd_flea_scl_size_current(hw))
+			goto quarantine;
+		hw->pfnWriteDevRegister(hw->adp, addresses[i], 0x00040002);
+		if (!crystalhd_flea_scl_size_current(hw))
+			goto quarantine;
+		value = hw->pfnReadDevRegister(hw->adp, addresses[i]);
+		if (!crystalhd_flea_scl_size_current(hw) || value != 0x00040002)
+			goto quarantine;
+		sizes[i] = 0x00040002;
+		sts = crystalhd_flea_scl_size_sample(hw, generation, owner, sizes, first);
+		if (sts != BC_STS_SUCCESS)
+			goto quarantine;
+	}
+	sts = crystalhd_flea_scl_size_sample(hw, generation, owner, sizes, second);
+	if (sts != BC_STS_SUCCESS || !crystalhd_flea_scl_size_current(hw) ||
+	    memcmp(first, second, sizeof(first)))
+		goto quarantine;
+	for (i = 0; i < ARRAY_SIZE(first); i++)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 scl-size-reset: phase=request word=%u first=%08x second=%08x\n",
+			 i, first[i], second[i]);
+	dev_info(&hw->adp->pdev->dev,
+		 "issue92 scl-size-reset: size-writes=3 top-writes=0 enable-writes=0 feed-starts=0 source-pattern-writes=0 configuration-only\n");
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+
+quarantine:
+	crystalhd_hw_dma_fatal_stop(hw);
+	return BC_STS_IO_ERROR;
+}
