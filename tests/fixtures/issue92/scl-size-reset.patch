+/* Called after checked core reset and DDR idle, BEFORE the first CLK_PM
+ * powerdown. Two old-cold tuples are corroboration, not all-consumer proof.
+ * Keep duty armed until the remaining stock stop AND post-stop PCI succeed.
+ */
+static BC_STATUS crystalhd_flea_scl_size_retire(struct crystalhd_hw *hw)
+{
+	static const uint32_t sizes[3] = { 0x02d000f0, 0x02d000f0, 0x02d000f0 };
+	uint32_t first[14], second[14];
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (!crystalhd_flea_scl_size_current(hw) || hw->research_scl_reset_corroborated)
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_scl_size_sample(hw, hw->research_scl_duty_generation,
+			hw->research_scl_duty_owner, sizes, first);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	sts = crystalhd_flea_scl_size_sample(hw, hw->research_scl_duty_generation,
+			hw->research_scl_duty_owner, sizes, second);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!crystalhd_flea_scl_size_current(hw) || memcmp(first, second, sizeof(first)))
+		return BC_STS_IO_ERROR;
+	for (i = 0; i < ARRAY_SIZE(first); i++)
+		dev_info(&hw->adp->pdev->dev,
+			 "issue92 scl-size-reset: phase=pre-clock-retire word=%u first=%08x second=%08x\n",
+			 i, first[i], second[i]);
+	hw->research_scl_reset_corroborated = true;
+	return BC_STS_SUCCESS;
+}
