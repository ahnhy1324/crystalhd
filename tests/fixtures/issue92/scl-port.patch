+static BC_STATUS run_scl_sample(uint32_t *snapshot)
+{
+	scl_probe_active = true;
+	const BC_STATUS status = crystalhd_flea_scl_port_sample(&hardware,
+			adapter.generation, &research_owner, snapshot);
+	scl_probe_active = false;
+	return status;
