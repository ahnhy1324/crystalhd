+	for (unsigned position = 1; position <= 79; ++position) {
+		const uint32_t offset = baseline[position - 1];
+		if (offset == 0x540030 || offset == 0x540000 || offset == 0x4000d4 || offset == 0xe0004 || offset == 0x540064) {
+			reset_scl(); scl_fault_read = position;
+			scl_fault_value = offset == 0xe0004 ? ARM_RUN_REQ_BIT : offset == 0x540000 ? 0 :
