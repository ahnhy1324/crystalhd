+static void scl_sample_results(void)
+{
+	groups++;
+	reset_scl();
+	check(run_scl_sample(NULL) == BC_STS_INV_ARG && no_effects() && !pci_reads,
+	      "a NULL snapshot refuses before any hardware or PCI call");
+	const uint32_t revisions[] = {1, 0x80, 0x1234, 0xfffe};
+	for (unsigned revision = 0; revision < ARRAY_SIZE(revisions); ++revision) {
+		for (unsigned selector = 0; selector < 4; ++selector) {
+			reset_scl();
+			scl_values[0] = revisions[revision];
+			scl_values[1] = selector ? 0xe : 0; /* TOP always-enable is not rejected as idle. */
+			scl_values[3] = selector;
+			scl_values[5] = selector & 1 ? UINT32_MAX : 0x30061000;
+			struct { uint32_t before, words[6], after; } result = {0x11223344, {0}, 0x55667788};
+			check(run_scl_sample(result.words) == BC_STS_SUCCESS && scl_reads == 16 &&
+			      !pci_reads && !scl_writes && result.before == 0x11223344 && result.after == 0x55667788,
+			      "sample admits plausible 16-bit revisions, four selectors and opaque DATA within owned six-word bounds");
+			for (unsigned n = 0; n < 5; ++n)
+				check(result.words[n] == scl_values[n], "sample preserves every captured bank scalar");
+			for (unsigned n = 0; n < 6; ++n)
+				check(scl_read_offsets[n + 5] == scl_offsets[n], "sample follows the literal fixed six-word bank order");
+			check_scl_no_other_targets();
+		}
+	}
+	const struct { unsigned field; uint32_t value; } invalid[] = {
+		{0, 0}, {0, 0xffff}, {0, 0x10000}, {0, UINT32_MAX},
+		{1, 1}, {1, 0x10}, {1, UINT32_MAX}, {2, 1}, {2, 2}, {2, UINT32_MAX},
+		{3, 4}, {3, UINT32_MAX}, {4, 1}, {4, 0x80}, {4, 0x100}, {4, UINT32_MAX},
+	};
+	for (unsigned n = 0; n < ARRAY_SIZE(invalid); ++n) {
+		reset_scl(); scl_values[invalid[n].field] = invalid[n].value;
+		uint32_t snapshot[6];
+		check(run_scl_sample(snapshot) == BC_STS_BUSY && scl_reads == 16 &&
+		      !scl_writes && !pci_clears && !fatal_stops,
+		      "reserved/implausible revision, TOP, ENABLE, selector or status fails read-only sample admission");
+	}
+	for (unsigned bit = 0; bit < 32; ++bit) {
+		reset_scl(); scl_values[2] = 1U << bit;
+		uint32_t snapshot[6];
+		check(run_scl_sample(snapshot) == BC_STS_BUSY && !scl_writes,
+		      "every nonzero ENABLE bit is rejected, not merely bit zero");
+		reset_scl(); scl_values[4] = 1U << bit;
+		check(run_scl_sample(snapshot) == BC_STS_BUSY && !scl_writes,
+		      "every status bit is rejected without reading or writing the distinct CLEAR register");
+	}
