+
+static unsigned scl_expected_reads(bool latch, uint32_t output[79])
+{
+	/* Independent literals: five shared/SCL guard words and six bank words. */
+	const uint32_t guard[] = {0x540000, 0x4000d4, 0xe0004, 0x540064, 0x540030};
+	unsigned count = 0;
+	memcpy(output + count, guard, sizeof(guard)); count += ARRAY_SIZE(guard);
+	for (unsigned phase = 0; phase < (latch ? 4U : 2U); ++phase) {
+		if (phase >= 2) {
+			memcpy(output + count, guard, sizeof(guard)); count += ARRAY_SIZE(guard);
+		}
+		memcpy(output + count, guard, sizeof(guard)); count += ARRAY_SIZE(guard);
+		memcpy(output + count, scl_offsets, sizeof(scl_offsets)); count += ARRAY_SIZE(scl_offsets);
+		memcpy(output + count, guard, sizeof(guard)); count += ARRAY_SIZE(guard);
+	}
+	return count;
+}
