+static void check_scl_no_other_targets(void)
+{
+	check(!colour_writes && !colour_starts && !mfd_target_writes &&
+	      !cmac_writes && !arm_run_writes && !heartbeats && !sleeps &&
+	      !colour_delays && !dram_writes && !dram_reads && !fpga_reads && !fpga_writes,
+	      "direct SCL qualification never starts an engine, touches DRAM, clocks or firmware");
