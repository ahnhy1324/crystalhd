+		u64 generation = adapter.generation; const void *owner = &research_owner;
+		switch (fault) {
+		case 0: hw = NULL; break; case 1: hardware.adp = NULL; break;
+		case 2: adapter.pdev = NULL; break; case 3: generation = 0; break;
+		case 4: owner = NULL; break; case 5: generation++; break;
