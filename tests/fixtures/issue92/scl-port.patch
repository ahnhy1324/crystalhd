+/* The previously observed pre-boot command latch must remain zero. This is
+ * not an engine-idle proof and must not guard the MFD colour START trial.
+ */
+static BC_STATUS crystalhd_flea_scl_port_guard(struct crystalhd_hw *hw,
+					    uint64_t generation, const void *owner)
+{
+	BC_STATUS sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+
+	if (sts != BC_STS_SUCCESS)
+		return hw && hw->research_mfd_pci_isolated ? BC_STS_IO_ERROR : sts;
+	if (hw->pfnReadDevRegister(hw->adp, BCHP_MFD_PIC_FEED_CMD))
+		return hw->research_mfd_pci_isolated ? BC_STS_IO_ERROR : BC_STS_BUSY;
+	if (!READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault))
+		return BC_STS_IO_ERROR;
+	return BC_STS_SUCCESS;
+}
+
+/* Only fixed control/status and the selected opaque debug word. The separate
+ * CLEAR register is excluded; RDB naming is not a read-side-effect contract.
+ */
+static BC_STATUS crystalhd_flea_scl_port_sample(struct crystalhd_hw *hw,
+					     uint64_t generation, const void *owner,
+					     uint32_t snapshot[6])
+{
+	static const uint32_t addresses[6] = {
+		BCHP_SCL_HD_REVISION_ID, BCHP_SCL_HD_TOP_CONTROL,
+		BCHP_SCL_HD_ENABLE, BCHP_SCL_HD_TEST_PORT_CONTROL,
+		BCHP_SCL_HD_BVB_IN_STATUS, BCHP_SCL_HD_TEST_PORT_DATA,
+	};
+	BC_STATUS sts;
+	unsigned int i;
+
+	if (!snapshot)
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_scl_port_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		snapshot[i] = hw->pfnReadDevRegister(hw->adp, addresses[i]);
+		if (!READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault))
+			return BC_STS_IO_ERROR;
+	}
+	dev_info(&hw->adp->pdev->dev,
+		 "issue92 scl-port: revision=%08x top=%08x enable=%08x selector=%08x status=%08x data=%08x\n",
+		 snapshot[0], snapshot[1], snapshot[2],
+			 snapshot[3], snapshot[4], snapshot[5]);
+	sts = crystalhd_flea_scl_port_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!snapshot[0] || snapshot[0] == 0xffff ||
+	    (snapshot[0] & BCHP_SCL_HD_REVISION_ID_reserved0_MASK) ||
+	    (snapshot[1] & ~0x0000000e) || snapshot[2] ||
+	    (snapshot[3] & BCHP_SCL_HD_TEST_PORT_CONTROL_reserved0_MASK) ||
+	    snapshot[4])
+		return BC_STS_BUSY;
+	return BC_STS_SUCCESS;
+}
+
+/* A reversible debug-selector qualification, NOT scaler execution or a pixel
+ * oracle. ENABLE=0 is only a register observation: TOP may say ALWAYS_ENABLE.
+ * No source, geometry, coefficient, feed, enable, reset or clock write.
+ * All target writes are the two literal selector values 1 then original 0.
+ */
+static BC_STATUS crystalhd_flea_scl_port_probe(struct crystalhd_hw *hw,
+					    uint64_t generation, const void *owner,
+					    bool latch)
+{
+	uint32_t initial[6] = {0}, fresh[6] = {0};
+	uint32_t toggled[6] = {0}, restored[6] = {0};
+	BC_STATUS sts, toggle_status;
+	struct crystalhd_adp *adp;
+	bool matched;
+	unsigned int i;
+
+	sts = crystalhd_flea_scl_port_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (hw->research_mfd_pci_isolated)
+		return BC_STS_BUSY;
+	adp = hw->adp;
+	/* Persistent duty is set before the attempted PCI change, as for MFD.
+	 * Neither these anchors nor a restored selector certify every master.
+	 */
+	hw->research_mfd_pci_isolated = true;
+	pci_clear_master(adp->pdev);
+	sts = crystalhd_flea_scl_port_sample(hw, generation, owner, initial);
+	if (sts == BC_STS_BUSY)
+		return sts; /* No selector write; ordinary checked stock retirement. */
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	if (initial[3])
+		return BC_STS_BUSY;
+	sts = crystalhd_flea_scl_port_sample(hw, generation, owner, fresh);
+	if (sts != BC_STS_SUCCESS)
+		goto quarantine;
+	for (i = 0; i < 5; i++)
+		if (fresh[i] != initial[i])
+			return BC_STS_BUSY;
+	if (!latch) {
+		dev_info(&adp->pdev->dev,
+			 "issue92 scl-port: writes=0 fixed-bank qualification only\n");
+		hw->research_mfd_deliberate_abort = true;
+		return BC_STS_CMD_CANCELLED;
+	}
+	if (crystalhd_flea_scl_port_guard(hw, generation, owner) != BC_STS_SUCCESS)
+		goto quarantine;
+	hw->pfnWriteDevRegister(adp, BCHP_SCL_HD_TEST_PORT_CONTROL, 1);
+	toggle_status = crystalhd_flea_scl_port_sample(hw, generation, owner, toggled);
+	if (toggle_status != BC_STS_SUCCESS && toggle_status != BC_STS_BUSY)
+		goto quarantine;
+	/* Restore once if checked access is still valid, including a mismatch.
+	 * Never perform blind MMIO restoration after access/ownership is lost.
+	 */
+	if (crystalhd_flea_scl_port_guard(hw, generation, owner) != BC_STS_SUCCESS)
+		goto quarantine;
+	hw->pfnWriteDevRegister(adp, BCHP_SCL_HD_TEST_PORT_CONTROL, 0);
+	sts = crystalhd_flea_scl_port_sample(hw, generation, owner, restored);
+	matched = toggle_status == BC_STS_SUCCESS && sts == BC_STS_SUCCESS &&
+		toggled[3] == 1 && restored[3] == 0;
+	for (i = 0; i < 5; i++)
+		if (i != 3 && (toggled[i] != initial[i] || restored[i] != initial[i]))
+			matched = false;
+	dev_info(&adp->pdev->dev,
+		 "issue92 scl-port: writes=2 selector=%08x/%08x/%08x matched=%u\n",
+		 initial[3], toggled[3], restored[3], matched);
+	if (!matched)
+		goto quarantine;
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+
+quarantine:
+	crystalhd_hw_dma_fatal_stop(hw);
+	return BC_STS_IO_ERROR;
+}
