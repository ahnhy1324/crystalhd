+static void scl_probe_results(void)
+{
+	groups++;
+	uint32_t expected[79];
+	for (unsigned latch = 0; latch < 2; ++latch) {
+		reset_scl();
+		check(run_scl(latch) == BC_STS_CMD_CANCELLED && !fatal_stops &&
+		      hardware.research_mfd_deliberate_abort && hardware.research_mfd_pci_isolated &&
+		      pci_clears == 1 && !(pci_command & PCI_COMMAND_MASTER) &&
+		      scl_reads == (latch ? 79U : 37U) && pci_reads == (latch ? 30U : 12U) &&
+		      scl_writes == (latch ? 2U : 0U) && scl_values[3] == 0 && state_unchanged(),
+		      "read-only and latch have exact logical REG/PCI budgets and deliberate pre-CMAC abort");
+		const unsigned expected_count = scl_expected_reads(latch, expected);
+		check(expected_count == scl_reads && !memcmp(expected, scl_read_offsets,
+		      expected_count * sizeof(expected[0])), "all successful reads follow an independent fixed-address oracle");
+		if (latch)
+			check(scl_write_offsets[0] == 0x540880 && scl_write_offsets[1] == 0x540880 &&
+			      scl_write_values[0] == 1 && scl_write_values[1] == 0,
+			      "two target writes are exactly selector one then original zero, with no START/ENABLE/geometry/reset");
+		check_scl_no_other_targets();
+		const unsigned writes = scl_writes;
+		check(run_scl(latch) == BC_STS_BUSY && scl_writes == writes,
+		      "persistent isolation prevents a second helper invocation from replaying selector writes");
+		check(run_close() == BC_STS_SUCCESS && suspend_calls == 1 && !hardware.dev_started &&
+		      hardware.research_mfd_pci_isolated && !fatal_stops,
+		      "both SCL modes retire only after actual extracted stock-close ordering and post-stop PCI guard");
+	}
+	for (unsigned mode = 0; mode < 2; ++mode) {
+		reset_scl();
+		if (!mode) scl_toggle_mismatch = true; else scl_restore_mismatch = true;
+		check(run_scl(true) == BC_STS_IO_ERROR && scl_writes == 2 && fatal_stops == 1 &&
+		      colour_retained() && !hardware.research_mfd_deliberate_abort,
+		      "selector readback mismatch restores once while access is valid, then quarantines without retry");
+	}
+	/* DATA is deliberately different in every sample and does not define success. */
+	for (unsigned top = 0; top < 16; top += 2) {
+		reset_scl(); scl_values[1] = top; scl_values[0] = 0x4321; scl_values[5] = UINT32_MAX;
+		check(run_scl(true) == BC_STS_CMD_CANCELLED && scl_writes == 2,
+		      "defined TOP modes, non-80 revision and opaque varying DATA are not mistaken for pixel or idle oracles");
+	}
