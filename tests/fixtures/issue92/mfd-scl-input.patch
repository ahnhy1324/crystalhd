+static bool crystalhd_flea_mfd_packed_input_current(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner)
+{
+	return READ_ONCE(hw->adp->present) && hw->adp->hw_accessible && !READ_ONCE(hw->dma_fault) &&
