+/* DATA, direct STATUS, pre-guard STATUS, post-guard STATUS. All DATA bits are
+ * opaque; the three status words remain separate non-atomic observations.
+ */
+static BC_STATUS crystalhd_flea_mfd_packed_input_sample(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, bool before_feed,
+		uint32_t snapshot[4])
+{
+	BC_STATUS sts;
+
+	if (!snapshot)
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_mfd_packed_input_guard(hw, generation, owner,
+			5, 0, 0, 4, 1, 2, before_feed, &snapshot[2]);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	snapshot[0] = hw->pfnReadDevRegister(hw->adp, BCHP_SCL_HD_TEST_PORT_DATA);
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner))
+		return BC_STS_IO_ERROR;
+	snapshot[1] = hw->pfnReadDevRegister(hw->adp, BCHP_SCL_HD_BVB_IN_STATUS);
+	if (!crystalhd_flea_mfd_packed_input_current(hw, generation, owner) ||
+	    (snapshot[1] & BCHP_SCL_HD_BVB_IN_STATUS_reserved0_MASK))
+		return BC_STS_IO_ERROR;
+	return crystalhd_flea_mfd_packed_input_guard(hw, generation, owner,
+			5, 0, 0, 4, 1, 2, before_feed, &snapshot[3]);
+}
