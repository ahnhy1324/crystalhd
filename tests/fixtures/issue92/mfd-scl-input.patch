+static BC_STATUS crystalhd_flea_mfd_packed_input_guard(struct crystalhd_hw *hw,
+		uint64_t generation, const void *owner, uint32_t ctrl,
+		uint32_t stride, uint32_t test, uint32_t hsize, uint32_t window,
+		uint32_t scl_selector, bool before_feed, uint32_t *scl_status)
+{
+	BC_STATUS sts;
+
+	if (!scl_status || (scl_selector != 0 && scl_selector != 2))
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_mfd_packed_guard_core(hw, generation, owner, ctrl,
+						stride, test, 4, hsize, window);
+	if (sts != BC_STS_SUCCESS)
+		return hw && hw->research_mfd_pci_isolated ? BC_STS_IO_ERROR : sts;
+	if (!READ_ONCE(hw->adp->present) || !hw->adp->hw_accessible ||
+	    READ_ONCE(hw->dma_fault) || hw->adp->generation != generation ||
+	    hw->adp->cmds.session_owner != owner)
+		return BC_STS_IO_ERROR;
+	sts = crystalhd_flea_mfd_packed_input_scl_guard(hw, generation, owner,
+						     scl_selector, before_feed, scl_status);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (!READ_ONCE(hw->adp->present) || !hw->adp->hw_accessible ||
+	    READ_ONCE(hw->dma_fault) || hw->adp->generation != generation ||
+	    hw->adp->cmds.session_owner != owner)
+		return BC_STS_IO_ERROR;
+	return BC_STS_SUCCESS;
+}
