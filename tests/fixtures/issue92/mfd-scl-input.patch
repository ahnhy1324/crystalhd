+/* New-mode-only counterpart with the same phase-aware address order. Check
+ * currentness before reporting a raw mismatch; legacy batched guards remain
+ * unchanged. Neither variant makes the register bundle an atomic snapshot.
+ */
+static BC_STATUS crystalhd_flea_mfd_packed_input_scl_guard(struct crystalhd_hw *hw,
 		uint64_t generation, const void *owner, uint32_t selector,
-		uint32_t window_profile)
+		bool before_feed, uint32_t *status)
+{
