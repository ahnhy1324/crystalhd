+	       !cmac_writes && !arm_run_writes && !heartbeats &&
+	       !hardware.research_mfd_deliberate_abort;
+}
+
+static void colour_results(void)
+{
+	groups++;
+	unsigned normal_reads = 0, normal_pci_reads = 0, normal_start_read_count = 0;
+	uint32_t read_order[ARRAY_SIZE(colour_read_offsets)];
+	const uint32_t colours[] = { 0x00405ac3, 0x00b2d32b };
+	for (unsigned c = 0; c < 2 * ARRAY_SIZE(colours); ++c) {
+		reset_colour(colours[c % ARRAY_SIZE(colours)]);
+		colour_initial_stride = c < ARRAY_SIZE(colours) ? 0 : 0x00800080;
+		check(run_colour() == BC_STS_CMD_CANCELLED && hardware.research_mfd_deliberate_abort &&
+		      hardware.research_mfd_pci_isolated && pci_clears == 1 && !fatal_stops &&
+		      !(pci_command & PCI_COMMAND_MASTER) && colour_starts == 1 &&
+		      colour_pulses == 16 && colour_delays == 32 && colour_writes == 42 &&
+		      !cmac_writes && !arm_run_writes && !heartbeats,
+		      "both fixed colours at both whitelisted strides abort before boot with one START and sixteen pulse pairs");
+		check(colour_reads == 362 && pci_reads == 186 && !sleeps,
+		      "exact successful host-access budget is 362 register reads and 186 checked PCI reads");
+		const uint32_t expected[] = { 13, colours[c % ARRAY_SIZE(colours)], 8, 0, 3, 0, 0, 15, 8, 1 };
+		for (unsigned n = 0; n < ARRAY_SIZE(expected); ++n)
+			check(colour_write_offsets[n] == colour_offsets[n] &&
+			      colour_write_values[n] == expected[n],
+			      "setup and START exactly match independent literal address/value oracle");
+		for (unsigned n = 10; n < colour_writes; ++n)
+			check(colour_write_offsets[n] == 0x540074 &&
+			      colour_write_values[n] == (n % 2 ? 8U : 9U),
+			      "each pulse is literal test mode nine/eight with no other target writes");
+		check(hardware.dev_started && adapter.cmds.session_owner == &research_owner &&
+		      state_unchanged() && !memcmp(&firmware, &firmware_before, sizeof(firmware)) &&
+		      colour_initial_stride == (c < ARRAY_SIZE(colours) ? 0U : 0x00800080U),
+		      "intentional abort is not retirement or mutation of firmware/host metadata");
+		normal_reads = colour_reads;
+		normal_pci_reads = pci_reads;
+		normal_start_read_count = colour_start_read_count;
+		memcpy(read_order, colour_read_offsets, sizeof(read_order));
+	}
+	const uint32_t rejected[] = { 0, 1, 0x405ac2, 0xb2d32a, 0xff405ac3, UINT32_MAX };
+	for (unsigned n = 0; n < ARRAY_SIZE(rejected); ++n) {
+		reset_colour(rejected[n]);
+		check(run_colour() == BC_STS_INV_ARG && no_effects() && !pci_reads && !pci_clears,
+		      "only two frozen fixed-colour values are admitted before any access");
+	}
+	for (unsigned failed = 1; failed <= normal_pci_reads; ++failed) {
+		reset_colour(colours[0]);
+		pci_fail_at = failed;
+		check(run_colour() == BC_STS_IO_ERROR && pci_reads == failed && fatal_stops == 1 &&
+		      colour_retained() && hardware.dma_fault && !adapter.present && colour_writes < 43,
+		      "every checked config transport failure stops immediately and quarantines retained backing");
+	}
+	for (unsigned flipped = 1; flipped <= normal_pci_reads; ++flipped) {
+		/* Every third read is DEVSTA; MASTER is checked by the other two. */
+		if (flipped % 3 == 2) continue;
+		reset_colour(colours[0]);
+		colour_pci_flip_at = flipped;
+		check(run_colour() == BC_STS_IO_ERROR && pci_reads == flipped && fatal_stops == 1 &&
+		      colour_retained() && !hardware.research_mfd_deliberate_abort,
+		      "MASTER reassertion at every COMMAND check quarantines immediately without a successful trial");
+	}
+	for (unsigned failed = 1; failed <= 9; ++failed) {
+		reset_colour(colours[0]);
+		colour_fail_after_write = failed;
+		check(run_colour() == BC_STS_IO_ERROR && colour_writes == failed && !colour_starts &&
+		      fatal_stops == 1 && colour_retained(),
+		      "each setup readback mismatch prevents START and quarantines without restoring registers");
+	}
+	/* Raw callback reads expose no status; test invalid/reserved raw results and
+	 * asynchronous context loss at the exact admitted read boundary instead.
+	 */
+	for (unsigned n = 0; n < normal_reads; ++n) {
+		const uint32_t offset = read_order[n];
+		uint32_t bad = 0;
+		if (offset == 0x540064) bad = 0x01000000; /* repeat enabled */
+		else if (offset == BCHP_MFD_REVISION_ID) bad = 0x51;
+		else if (offset == BCHP_SUN_GISB_ARB_ERR_CAP_STATUS) bad = 1;
+		else if (offset == BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL) bad = ARM_RUN_REQ_BIT;
+		else if (offset == 0x540078 || offset == 0x540080 || offset == 0x540050 ||
+			 offset == 0x540070 || offset == 0x54006c) bad = UINT32_MAX;
+		else continue;
+		reset_colour(colours[0]);
+		colour_fault_read = n + 1;
+		colour_fault_value = bad;
+		const BC_STATUS status = run_colour();
+		check(status != BC_STS_SUCCESS && status != BC_STS_CMD_CANCELLED &&
+		      !hardware.research_mfd_deliberate_abort && !cmac_writes && !arm_run_writes,
+		      "every guard/raw observation rejects corrupt revision, errors, repeat, run or reserved data");
+		if (pci_clears)
+			check(fatal_stops == 1 && colour_retained(),
+			      "post-isolation observation failures retain and quarantine");
+		else check(!colour_writes && !colour_starts && !fatal_stops,
+			   "pre-isolation read-only admission failure has no register/config write");
+		if (n < normal_start_read_count)
+			check(!colour_starts, "pre-START invalid observations must not start feeder");
+	}
+	/* Locate the pre-sample and pre-tap reads without relying on incidental
+	 * guard counts; a fault there must be caught by the fresh pre-START guard.
+	 */
+	for (unsigned n = 0, selected = 0; n < normal_reads && selected < 2; ++n) {
+		if (read_order[n] != 0x540078 && read_order[n] != 0x540080) continue;
+		selected++;
+		for (unsigned kind = 1; kind <= 4; ++kind) {
+			reset_colour(colours[0]);
+			colour_state_fault_read = n + 1;
+			colour_state_fault_kind = kind;
+			check(run_colour() == BC_STS_IO_ERROR && !colour_starts && fatal_stops == 1 &&
+			      colour_retained(),
+			      "asynchronous fault/removal/GISB/ARM change in pre-sample/tap prevents START");
+		}
+	}
+	for (unsigned n = 1; n <= normal_reads; ++n) {
+		for (unsigned kind = 1; kind <= 2; ++kind) {
+			reset_colour(colours[0]);
+			colour_state_fault_read = n;
+			colour_state_fault_kind = kind;
+			const BC_STATUS status = run_colour();
+			check(status != BC_STS_SUCCESS && status != BC_STS_CMD_CANCELLED &&
+			      colour_writes == colour_fault_writes && !hardware.research_mfd_deliberate_abort &&
+			      !cmac_writes && !arm_run_writes && !heartbeats,
+			      "loss of presence or DMA safety at every device read permits no subsequent register write");
+			if (hardware.research_mfd_pci_isolated)
+				check(fatal_stops == 1 && colour_retained(),
+				      "all post-isolation asynchronous faults retain owner/backing and quarantine");
+		}
+	}
+	for (unsigned n = normal_start_read_count; n < normal_reads; ++n) {
+		if (read_order[n] != 0x54006c) continue;
+		for (unsigned bit = 0; bit < 3; ++bit) {
+			reset_colour(colours[0]);
+			colour_fault_read = n + 1;
+			colour_fault_value = 1U << bit;
+			check(run_colour() == BC_STS_CMD_CANCELLED && colour_starts == 1 &&
+			      !colour_pulses && colour_writes == 10 && !colour_delays && !fatal_stops &&
+			      hardware.research_mfd_deliberate_abort && !cmac_writes && !arm_run_writes,
+			      "defined feeder errors stop pulses early with deliberate abort, not completion proof");
+		}
+		break;
+	}
+	reset_colour(colours[0]);
+	pci_clear_failed = true;
+	check(run_colour() == BC_STS_IO_ERROR && !colour_writes && !colour_starts &&
+	      fatal_stops == 1 && colour_retained(),
+	      "failed MASTER clear never admits even the first setup register write");
+	reset_colour(colours[0]);
+	check(run_colour() == BC_STS_CMD_CANCELLED, "prepare one successful isolated trial");
+	const unsigned previous_writes = colour_writes;
+	check(run_colour() != BC_STS_CMD_CANCELLED && colour_writes == previous_writes,
+	      "persistent isolated context cannot replay the one-shot trial");
+}
+
+static void colour_context_results(void)
+{
+	groups++;
+	for (unsigned fault = 0; fault < 47; ++fault) {
+		reset_colour(0x405ac3);
+		struct crystalhd_hw *hw = &hardware;
+		u64 generation = adapter.generation;
+		const void *owner = &research_owner;
+		switch (fault) {
+		case 0: hw = NULL; break;
+		case 1: hardware.adp = NULL; break;
+		case 2: adapter.pdev = NULL; break;
+		case 3: generation = 0; break;
+		case 4: owner = NULL; break;
+		case 5: hardware.pfnReadDevRegister = NULL; break;
+		case 6: hardware.pfnWriteDevRegister = NULL; break;
+		case 7: adapter.present = 0; break;
+		case 8: adapter.hw_accessible = false; break;
+		case 9: generation++; break;
+		case 10: pci.device = 0x1612; break;
+		case 11: adapter.i2o_addr = NULL; break;
+		case 12: adapter.pci_i2o_len = FLEA_GISB_INDIRECT_DATA + 3; break;
+		case 13: adapter.cmds.adp = NULL; break;
+		case 14: adapter.cmds.hw_ctx = NULL; break;
+		case 15: owner = &hardware; break;
+		case 16: adapter.cmds.session_module_pinned = false; break;
+		case 17: adapter.cmds.state = 1; break;
+		case 18: adapter.cfg_users = 1; break;
+		case 19: hardware.dev_started = false; break;
+		case 20: hardware.dma_fault = true; break;
+		case 21: hardware.RxCaptureState = 1; break;
+		case 22: hardware.fwcmd_pending = true; break;
+		case 23: hardware.fwcmd_poisoned = true; break;
+		case 24: hardware.FwCmdCnt = 1; break;
+		case 25: hardware.tx_actq = NULL; break;
+		case 26: hardware.rx_actq = NULL; break;
+		case 27: hardware.rx_rdyq = NULL; break;
+		case 28: hardware.rx_freeq = NULL; break;
+		case 29: hardware.TxList0Sts = 1; break;
+		case 30: hardware.TxList1Sts = 1; break;
+		case 31: hardware.rx_list_sts[0] = 1; break;
+		case 32: hardware.rx_list_sts[1] = 1; break;
+		case 33: hardware.tx_pkt_pool[0].list_tag = 1; break;
+		case 34: hardware.tx_pkt_pool[1].list_tag = 1; break;
+		default: {
+			const unsigned queue_indices[] = {1, 3, 4, 2};
+			struct crystalhd_dioq *queue = &queues[queue_indices[(fault - 35) / 3]];
+			if ((fault - 35) % 3 == 0) queue->count = 1;
+			else if ((fault - 35) % 3 == 1) queue->head = &hardware;
+			else queue->tail = &hardware;
+			break;
+		}
+		}
+		check(crystalhd_flea_mfd_colour_probe(hw, generation, owner, colour_selected) !=
+		      BC_STS_CMD_CANCELLED && no_effects() && !pci_reads && !pci_clears && !fatal_stops,
+		      "each fresh-context/queue/tag/capture/owner guard rejects before device or PCI access");
+	}
+	for (unsigned n = 0; n < ARRAY_SIZE(colour_offsets) - 1; ++n) {
+		reset_colour(0x405ac3);
+		colour_values[n] = UINT32_MAX;
+		check(run_colour() == (n ? BC_STS_IO_ERROR : BC_STS_BUSY) &&
+		      !pci_clears && !colour_writes && !colour_starts,
+		      "reserved initial setup register bits reject during read-only admission");
+	}
+	const uint32_t rejected_strides[] = {
+		1, 0x00000080, 0x00800000, 0x00800081, 0x00810080, 0x01000100, UINT32_MAX,
+	};
+	for (unsigned n = 0; n < ARRAY_SIZE(rejected_strides); ++n) {
+		reset_colour(0x405ac3);
+		colour_initial_stride = rejected_strides[n];
+		check(run_colour() == BC_STS_BUSY && !pci_clears && !colour_writes && !colour_starts,
+		      "only zero or the exact observed00800080 stride is admitted before isolation or writes");
+	}
+	const uint32_t rejected_modes[] = {1, 2, 4, 8, 13, 15, UINT32_MAX};
+	for (unsigned n = 0; n < ARRAY_SIZE(rejected_modes); ++n) {
+		reset_colour(0x405ac3);
+		colour_initial_stride = 0x00800080;
+		colour_values[0] = rejected_modes[n];
+		check(run_colour() == BC_STS_BUSY && !pci_clears && !colour_writes && !colour_starts,
+		      "observed stride admission still requires exact initial AVC_MPEG feeder control zero");
+	}
+	const unsigned empty_queue_indices[] = {1, 3, 4, 2};
+	for (unsigned n = 0; n < ARRAY_SIZE(empty_queue_indices); ++n) {
+		for (unsigned malformed = 0; malformed < 4; ++malformed) {
+			reset_colour(0x405ac3);
+			struct crystalhd_dioq *queue = &queues[empty_queue_indices[n]];
+			if (malformed == 0) queue->head = NULL;
+			else if (malformed == 1) queue->tail = NULL;
+			else if (malformed == 2) queue->head = &queues[0].head;
+			else queue->tail = &queues[0].head;
+			check(run_colour() == BC_STS_BUSY && no_effects() && !pci_reads && !pci_clears,
+			      "zero count still requires both exact self-sentinels, rejecting NULL or other queue topology");
+		}
+	}
+	const uint32_t zero_only_offsets[] = { 0x540030, 0x54001c, 0x540020, 0x540010, 0x54006c };
+	for (unsigned n = 0; n < ARRAY_SIZE(zero_only_offsets); ++n) {
+		reset_colour(0x405ac3);
+		/* Initial guard has four reads, then these five zero-only anchors. */
+		colour_fault_read = n + 5;
+		colour_fault_value = 1;
+		check(run_colour() == BC_STS_BUSY && !pci_clears && !colour_writes,
+		      "nonzero initial feed/line-address/stride/error anchors prevent isolation and programming");
+		check(colour_read_offsets[n + 4] == zero_only_offsets[n],
+		      "each injected zero-only admission read is the independent literal target");
+	}
+	reset_colour(0x405ac3);
+	colour_fault_read = 4;
+	colour_fault_value = UINT32_MAX;
+	check(run_colour() == BC_STS_IO_ERROR && !pci_clears && !colour_writes,
+	      "repeat-control all-ones/reserved result fails read-only admission");
+}
+
+static void colour_download_results(void)
+{
+	groups++;
+	for (unsigned n = 0; n < 4; ++n) {
+		reset_colour(n % 2 ? 0xb2d32b : 0x405ac3);
+		colour_initial_stride = n < 2 ? 0 : 0x00800080;
+		hardware.research_staging_probe = true;
+		hardware.research_mfd_colour_probe = true;
+		hardware.research_mfd_colour_value = colour_selected;
+		const BC_STATUS status = crystalhd_flea_download_fw(&hardware,
+			(const uint8_t *)firmware.words, sizeof(firmware.words));
+		if (status != BC_STS_CMD_CANCELLED)
+			fprintf(stderr, "colour download status=%d calls=%u reads=%u writes=%u DRAM=%u/%u PCI=%u fatal=%u\n",
+				status, colour_calls, dev_reads, dev_writes, dram_writes, dram_reads,
+				pci_reads, fatal_stops);
+		check(status == BC_STS_CMD_CANCELLED && colour_calls == 1 &&
+		      dram_writes == 3 && dram_reads == 3 && !mfd_calls && !cmac_writes &&
+		      !arm_run_writes && !heartbeats && hardware.research_mfd_deliberate_abort &&
+		      !memcmp(&firmware, &firmware_before, sizeof(firmware)) &&
+		      hardware.fwcmdPostMbox == FW_CMD_POST_MBOX &&
+		      hardware.fwcmdRespMbox == FW_CMD_RES_MBOX,
+		      "actual downloader restores stock staging then returns colour abort without CMAC or ARM run");
+	}
+	for (unsigned fault = 0; fault < 6; ++fault) {
+		reset_colour(0x405ac3);
+		hardware.research_staging_probe = true;
+		hardware.research_mfd_colour_probe = true;
+		hardware.research_mfd_colour_value = colour_selected;
+		if (fault == 0) hardware.research_staging_probe = false;
+		else if (fault == 1) hardware.research_mfd_owner = NULL;
+		else if (fault == 2) hardware.research_mfd_generation = 0;
+		else if (fault == 3) hardware.research_mfd_latch_probe = true;
+		else if (fault == 4) hardware.research_mfd_colour_value = 0;
+		else hardware.research_mfd_deliberate_abort = true;
+		check(crystalhd_flea_download_fw(&hardware, (const uint8_t *)firmware.words,
+		      sizeof(firmware.words)) == BC_STS_INV_ARG && no_effects() && !colour_calls &&
+		      !pci_reads && !pci_clears && !hardware.research_mfd_colour_probe &&
+		      !hardware.research_mfd_colour_value && !hardware.research_mfd_owner &&
+		      !hardware.research_mfd_generation,
+		      "invalid private download admission consumes one-shot inputs before all hardware effects");
+	}
+	for (unsigned fault = 0; fault < 5; ++fault) {
+		reset_colour(0x405ac3);
+		hardware.research_staging_probe = true;
+		hardware.research_mfd_colour_probe = true;
+		hardware.research_mfd_colour_value = colour_selected;
+		if (fault == 0) hardware.research_mfd_generation++;
+		else if (fault == 1) hardware.research_mfd_owner = &hardware;
+		else if (fault == 2) adapter.cfg_users = 1;
+		else if (fault == 3) hardware.RxCaptureState = 1;
+		else hardware.fwcmd_pending = true;
+		check(crystalhd_flea_download_fw(&hardware, (const uint8_t *)firmware.words,
+		      sizeof(firmware.words)) == BC_STS_BUSY && no_effects() && !colour_calls &&
+		      !pci_reads && !pci_clears && state_unchanged(),
+		      "early downloader colour admission rejects stale owner/generation/live state before loader effects");
+	}
+}
+
+static BC_STATUS run_close(void)
+{
+	close_probe_active = true;
+	close_started_snapshot = hardware.dev_started;
+	const BC_STATUS status = crystalhd_hw_close(&hardware);
+	close_probe_active = false;
+	return status;
+}
+
+static void close_isolation_results(void)
+{
+	groups++;
+	reset();
+	check(run_close() == BC_STS_SUCCESS && suspend_calls == 1 &&
+	      !hardware.dev_started && !pci_reads && !fatal_stops,
+	      "ordinary close retains its original suspend-only behavior");
+	reset();
+	hardware.dev_started = false;
+	check(run_close() == BC_STS_SUCCESS && !suspend_calls && !pci_reads,
+	      "ordinary inactive close remains effect-free");
+	for (int raw = BC_STS_ERROR; raw <= BC_STS_PWR_MGMT; ++raw) {
+		if (raw == BC_STS_SUCCESS) continue;
+		reset();
+		hardware.research_mfd_pci_isolated = true;
+		suspend_status = (BC_STATUS)raw;
+		check(run_close() == raw && suspend_calls == 1 && hardware.dev_started &&
+		      !pci_reads && !fatal_stops &&
+		      adapter.cmds.session_owner == &research_owner,
+		      "failed stock suspend never reaches guard or marks the owner/context retired");
+	}
+	for (unsigned started = 0; started < 2; ++started) {
+		reset();
+		hardware.dev_started = started;
+		hardware.research_mfd_pci_isolated = true;
+		pci_command = PCI_COMMAND_MEMORY;
+		check(run_close() == BC_STS_SUCCESS && suspend_calls == started &&
+		      pci_reads == 3 && !hardware.dev_started && !pci_clears && !fatal_stops &&
+		      hardware.research_mfd_pci_isolated,
+		      "persistent isolation is checked after stop even for an already-inactive context");
+	}
+	for (unsigned fault = 0; fault < 4; ++fault) {
+		reset();
+		hardware.research_mfd_pci_isolated = true;
+		pci_command = PCI_COMMAND_MEMORY;
+		if (fault == 0) pci_command |= PCI_COMMAND_MASTER;
+		else if (fault == 1) pci_command = 0;
+		else if (fault == 2) pci_fail_at = 1;
+		else for (unsigned n = 0; n < ARRAY_SIZE(pci_pending); ++n)
+			pci_pending[n] = PCI_EXP_DEVSTA_TRPND;
+		check(run_close() == BC_STS_IO_ERROR && suspend_calls == 1 &&
+		      hardware.dev_started && hardware.dma_fault && !adapter.present &&
+		      fatal_stops == 1 && adapter.cmds.session_owner == &research_owner &&
+		      adapter.cmds.session_module_pinned && hardware.research_mfd_pci_isolated &&
+		      hardware.tx_freeq == &queues[0] && hardware.rx_freeq == &queues[2] &&
+		      queues[0].count == BC_TX_LIST_CNT && queues[2].count == BC_RX_LIST_CNT &&
+		      queue_sentinels_retained(),
+		      "post-stop PCI guard failure quarantines without retiring owner, started flag or backing");
+	}
+	reset();
+	hardware.dma_fault = true;
+	hardware.research_mfd_pci_isolated = true;
+	check(run_close() == BC_STS_IO_ERROR && !suspend_calls && !pci_reads &&
+	      hardware.dev_started && adapter.cmds.session_owner == &research_owner,
+	      "an already-quarantined context cannot enter normal close or fabricate retirement");
+}
