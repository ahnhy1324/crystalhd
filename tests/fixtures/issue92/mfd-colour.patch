+/* Checked configuration observations, not a proof that every posted write or
+ * local DDR initiator is idle. MEMORY remains enabled for host BAR access.
+ */
+BC_STATUS crystalhd_flea_research_pci_guard(struct crystalhd_hw *hw)
+{
+	struct pci_dev *pdev;
+	uint16_t command, pending;
+	unsigned int attempt;
+	int cap;
+
+	if (!hw || !hw->adp || !hw->adp->pdev ||
+	    !hw->research_mfd_pci_isolated || !READ_ONCE(hw->adp->present) ||
+	    !hw->adp->hw_accessible)
+		return BC_STS_IO_ERROR;
+	pdev = hw->adp->pdev;
+	cap = pci_pcie_cap(pdev);
+	if (!pci_is_pcie(pdev) || !cap)
+		return BC_STS_IO_ERROR;
+	for (attempt = 0; attempt < 4; attempt++) {
+		if (pci_read_config_word(pdev, PCI_COMMAND, &command) ||
+		    command == 0xffff || !(command & PCI_COMMAND_MEMORY) ||
+		    (command & PCI_COMMAND_MASTER) ||
+		    pci_read_config_word(pdev, cap + PCI_EXP_DEVSTA, &pending) ||
+		    pending == 0xffff)
+			return BC_STS_IO_ERROR;
+		if (!(pending & PCI_EXP_DEVSTA_TRPND)) {
+			/* Recheck after DEVSTA; neither read ignores transport status. */
+			if (pci_read_config_word(pdev, PCI_COMMAND, &command) ||
+			    command == 0xffff || !(command & PCI_COMMAND_MEMORY) ||
+			    (command & PCI_COMMAND_MASTER) ||
+			    !READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault))
+				return BC_STS_IO_ERROR;
+			return BC_STS_SUCCESS;
+		}
+		if (attempt != 3)
+			msleep(10);
+	}
+	return BC_STS_IO_ERROR;
+}
+
+static BC_STATUS crystalhd_flea_mfd_colour_guard(struct crystalhd_hw *hw,
+					       uint64_t generation, const void *owner)
+{
+	const uint32_t gisb_mask = BCHP_SUN_GISB_ARB_ERR_CAP_STATUS_valid_MASK |
+		BCHP_SUN_GISB_ARB_ERR_CAP_STATUS_tea_MASK |
+		BCHP_SUN_GISB_ARB_ERR_CAP_STATUS_timeout_MASK;
+	struct crystalhd_adp *adp;
+	struct crystalhd_cmd *ctx;
+	unsigned int i;
+
+	if (!hw || !hw->adp || !hw->adp->pdev || !generation || !owner ||
+	    !hw->pfnReadDevRegister || !hw->pfnWriteDevRegister)
+		return BC_STS_INV_ARG;
+	adp = hw->adp;
+	ctx = &adp->cmds;
+	lockdep_assert_held_write(&adp->user_lock);
+	if (!READ_ONCE(adp->present) || !adp->hw_accessible ||
+	    adp->generation != generation || adp->pdev->device != BC_PCI_DEVID_FLEA ||
+	    !adp->i2o_addr ||
+	    adp->pci_i2o_len < FLEA_GISB_INDIRECT_DATA + sizeof(uint32_t) ||
+	    ctx->adp != adp || ctx->hw_ctx != hw || ctx->session_owner != owner ||
+	    !ctx->session_module_pinned || ctx->state != BC_LINK_INVALID ||
+	    adp->cfg_users || !hw->dev_started || READ_ONCE(hw->dma_fault) ||
+	    hw->RxCaptureState || hw->fwcmd_pending || hw->fwcmd_poisoned ||
+	    READ_ONCE(hw->FwCmdCnt) || !hw->tx_actq || !hw->rx_actq ||
+	    !hw->rx_rdyq || !hw->rx_freeq ||
+	    hw->tx_actq->count ||
+	    hw->tx_actq->head != (struct crystalhd_elem *)&hw->tx_actq->head ||
+	    hw->tx_actq->tail != (struct crystalhd_elem *)&hw->tx_actq->head ||
+	    hw->rx_actq->count ||
+	    hw->rx_actq->head != (struct crystalhd_elem *)&hw->rx_actq->head ||
+	    hw->rx_actq->tail != (struct crystalhd_elem *)&hw->rx_actq->head ||
+	    hw->rx_rdyq->count ||
+	    hw->rx_rdyq->head != (struct crystalhd_elem *)&hw->rx_rdyq->head ||
+	    hw->rx_rdyq->tail != (struct crystalhd_elem *)&hw->rx_rdyq->head ||
+	    hw->rx_freeq->count ||
+	    hw->rx_freeq->head != (struct crystalhd_elem *)&hw->rx_freeq->head ||
+	    hw->rx_freeq->tail != (struct crystalhd_elem *)&hw->rx_freeq->head ||
+	    hw->TxList0Sts != ListStsFree || hw->TxList1Sts != ListStsFree)
+		return BC_STS_BUSY;
+	for (i = 0; i < DMA_ENGINE_CNT; i++)
+		if (hw->rx_list_sts[i] != sts_free || hw->tx_pkt_pool[i].list_tag)
+			return BC_STS_BUSY;
+	if (hw->research_mfd_pci_isolated &&
+	    crystalhd_flea_research_pci_guard(hw) != BC_STS_SUCCESS)
+		return BC_STS_IO_ERROR;
+	if (hw->pfnReadDevRegister(adp, BCHP_MFD_REVISION_ID) != 0x50 ||
+	    (hw->pfnReadDevRegister(adp, BCHP_SUN_GISB_ARB_ERR_CAP_STATUS) & gisb_mask) ||
+	    (hw->pfnReadDevRegister(adp, BCHP_ARMCR4_BRIDGE_REG_BRIDGE_CTL) & ARM_RUN_REQ_BIT) ||
+	    (hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_TIMEOUT_REPEAT_PIC_CNTL) &
+	     (BCHP_MFD_FEEDER_TIMEOUT_REPEAT_PIC_CNTL_REPEAT_PIC_ENABLE_MASK |
+	      BCHP_MFD_FEEDER_TIMEOUT_REPEAT_PIC_CNTL_reserved0_MASK)) ||
+	    !READ_ONCE(adp->present) || READ_ONCE(hw->dma_fault))
+		return BC_STS_IO_ERROR;
+	return BC_STS_SUCCESS;
+}
+
+/* Volatile, pre-boot fixed-colour experiment. RDB names do not establish DDR
+ * bypass, downstream isolation, geometry units or pulse/START edge semantics.
+ * Bounds apply to host operations, NOT emitted beats or local memory writes.
+ * Never restore live controls or start firmware afterwards: retire via stock
+ * stop/reset with MASTER kept clear, and retain ownership on guard failure.
+ */
+static BC_STATUS crystalhd_flea_mfd_colour_probe(struct crystalhd_hw *hw,
+					      uint64_t generation, const void *owner,
+					      uint32_t colour)
+{
+	const uint32_t test_mode = BCHP_MFD_TEST_MODE_CNTL_BVB_TEST_MODE_MASK;
+	struct {
+		uint32_t address, value, allowed;
+	} controls[] = {
+		{ BCHP_MFD_FEEDER_CNTL,
+		  BCHP_MFD_FEEDER_CNTL_FIXED_COLOUR_ENABLE_MASK |
+		  (BCHP_MFD_FEEDER_CNTL_PACKING_TYPE_Y0_U0_Y1_V0 <<
+		   BCHP_MFD_FEEDER_CNTL_PACKING_TYPE_SHIFT) |
+		  BCHP_MFD_FEEDER_CNTL_IMAGE_FORMAT_PACKED,
+		  ~BCHP_MFD_FEEDER_CNTL_reserved0_MASK },
+		{ BCHP_MFD_FIXED_COLOUR, colour, 0x00ffffff },
+		{ BCHP_MFD_DISP_HSIZE, 8, BCHP_MFD_DISP_HSIZE_VALUE_MASK },
+		{ BCHP_MFD_PICTURE0_DISP_VERT_WINDOW, 0,
+		  BCHP_MFD_PICTURE0_DISP_VERT_WINDOW_START_MASK |
+		  BCHP_MFD_PICTURE0_DISP_VERT_WINDOW_END_MASK },
+		{ BCHP_MFD_LAC_CNTL, BCHP_MFD_LAC_CNTL_OUTPUT_TYPE_MASK |
+		  BCHP_MFD_LAC_CNTL_CHROMA_TYPE_MASK,
+		  ~(BCHP_MFD_LAC_CNTL_reserved0_MASK | BCHP_MFD_LAC_CNTL_reserved1_MASK) },
+		{ BCHP_MFD_CHROMA_SAMPLING_CNTL, 0,
+		  BCHP_MFD_CHROMA_SAMPLING_CNTL_CHROMA_REPOSITION_ENABLE_MASK },
+		{ BCHP_MFD_DATA_MODE, 0, BCHP_MFD_DATA_MODE_PIXEL_WIDTH_MASK },
+		{ BCHP_MFD_TEST_PORT_CNTL, BCHP_MFD_TEST_PORT_CNTL_ADDR_SEL_MASK |
+		  BCHP_MFD_TEST_PORT_CNTL_TP_ADDR_BVB_OUT,
+		  ~BCHP_MFD_TEST_PORT_CNTL_reserved0_MASK },
+		{ BCHP_MFD_TEST_MODE_CNTL, test_mode,
+		  ~BCHP_MFD_TEST_MODE_CNTL_reserved0_MASK },
+	};
+	struct crystalhd_adp *adp;
+	uint32_t sample, tap, feed, bvb, feeder, original;
+	uint32_t admission[5];
+	unsigned int i, pulses = 0;
+	BC_STATUS sts;
+
+	if (colour != 0x00405ac3 && colour != 0x00b2d32b)
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	if (hw->research_mfd_pci_isolated)
+		return BC_STS_BUSY;
+	adp = hw->adp;
+	admission[0] = hw->pfnReadDevRegister(adp, BCHP_MFD_PIC_FEED_CMD);
+	admission[1] = hw->pfnReadDevRegister(adp, BCHP_MFD_PICTURE0_LINE_ADDR_0);
+	admission[2] = hw->pfnReadDevRegister(adp, BCHP_MFD_PICTURE0_LINE_ADDR_1);
+	admission[3] = hw->pfnReadDevRegister(adp, BCHP_MFD_STRIDE);
+	admission[4] = hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS);
+	dev_info(&adp->pdev->dev,
+		 "issue92 colour-admission: writes=0 cmd=%08x addr0=%08x addr1=%08x stride=%08x feeder=%08x\n",
+		 admission[0], admission[1], admission[2], admission[3], admission[4]);
+	/* Two fresh pre-boot observations retained paired AVC strides of 128.
+	 * Admit that exact raw value only with the initial feeder control zero;
+	 * do not write a stride or infer source units/bypass from this observation.
+	 */
+	if (admission[0] || admission[1] || admission[2] || admission[4] ||
+	    (admission[3] && admission[3] != 0x00800080))
+		return BC_STS_BUSY;
+	for (i = 0; i < ARRAY_SIZE(controls); i++) {
+		original = hw->pfnReadDevRegister(adp, controls[i].address);
+		if (!i) {
+			dev_info(&adp->pdev->dev,
+				 "issue92 colour-admission: feeder-mode=%08x stride-retained=%08x\n",
+				 original, admission[3]);
+			if (original)
+				return BC_STS_BUSY;
+		}
+		if (original & ~controls[i].allowed)
+			return BC_STS_IO_ERROR;
+	}
+	/* Set before the attempted PCI update, including failed/unreadable writes.
+	 * Only successful context retirement may discard this containment duty.
+	 */
+	hw->research_mfd_pci_isolated = true;
+	pci_clear_master(adp->pdev);
+	if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+		goto quarantine;
+	for (i = 0; i < ARRAY_SIZE(controls); i++) {
+		if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+			goto quarantine;
+		hw->pfnWriteDevRegister(adp, controls[i].address, controls[i].value);
+		if (hw->pfnReadDevRegister(adp, controls[i].address) != controls[i].value)
+			goto quarantine;
+	}
+	if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+		goto quarantine;
+	sample = hw->pfnReadDevRegister(adp, BCHP_MFD_BVB_SAMPLE_DATA);
+	tap = hw->pfnReadDevRegister(adp, BCHP_MFD_TEST_PORT_DATA);
+	dev_info(&adp->pdev->dev,
+		 "issue92 colour: fixed=%08x hsize-raw=8 vwindow-raw=0 intended=8x1 pre-sample=%08x pre-tap=%08x master=0\n",
+		 colour, sample, tap);
+	if ((sample & BCHP_MFD_BVB_SAMPLE_DATA_reserved0_MASK) ||
+	    (tap & 0xf0000000))
+		goto quarantine;
+	if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+		goto quarantine;
+	hw->pfnWriteDevRegister(adp, BCHP_MFD_PIC_FEED_CMD,
+				BCHP_MFD_PIC_FEED_CMD_START_FEED_MASK);
+	for (i = 0; i <= 16; i++) {
+		if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+			goto quarantine;
+		sample = hw->pfnReadDevRegister(adp, BCHP_MFD_BVB_SAMPLE_DATA);
+		tap = hw->pfnReadDevRegister(adp, BCHP_MFD_TEST_PORT_DATA);
+		feed = hw->pfnReadDevRegister(adp, BCHP_MFD_FEED_STATUS);
+		bvb = hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_BVB_STATUS);
+		feeder = hw->pfnReadDevRegister(adp, BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS);
+		dev_info(&adp->pdev->dev,
+			 "issue92 colour: observation=%u host-pulses=%u sample=%08x tap=%08x feed=%08x bvb=%08x feeder=%08x\n",
+			 i, pulses, sample, tap, feed, bvb, feeder);
+		if ((sample & BCHP_MFD_BVB_SAMPLE_DATA_reserved0_MASK) ||
+		    (tap & 0xf0000000) ||
+		    (feed & (BCHP_MFD_FEED_STATUS_reserved0_MASK |
+			     BCHP_MFD_FEED_STATUS_reserved1_MASK)) ||
+		    (bvb & BCHP_MFD_FEEDER_BVB_STATUS_reserved0_MASK) ||
+		    (feeder & BCHP_MFD_FEEDER_ERROR_INTERRUPT_STATUS_reserved0_MASK))
+			goto quarantine;
+		if (i == 16 || feeder)
+			break;
+		if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+			goto quarantine;
+		hw->pfnWriteDevRegister(adp, BCHP_MFD_TEST_MODE_CNTL,
+					test_mode | BCHP_MFD_TEST_MODE_CNTL_ACCEPT_PULSE_MASK);
+		udelay(10);
+		if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+			goto quarantine;
+		hw->pfnWriteDevRegister(adp, BCHP_MFD_TEST_MODE_CNTL, test_mode);
+		pulses++;
+		udelay(10);
+	}
+	if (crystalhd_flea_mfd_colour_guard(hw, generation, owner) != BC_STS_SUCCESS)
+		goto quarantine;
+	hw->research_mfd_deliberate_abort = true;
+	return BC_STS_CMD_CANCELLED;
+
+quarantine:
+	crystalhd_hw_dma_fatal_stop(hw);
+	return BC_STS_IO_ERROR;
+}
