+/* Non-atomic raw tuple: DATA, STATUS, pre-guard STATUS, post-guard STATUS.
+ * Preserve all three status observations instead of assuming sticky flags or
+ * inventing an OR value as a raw register sample. DATA is opaque, never a
+ * pointer or pixel value. There is no command-zero expectation after START.
+ */
+static BC_STATUS crystalhd_flea_mfd_scl_sample(struct crystalhd_hw *hw,
+					    uint64_t generation, const void *owner,
+					    uint32_t snapshot[4])
+{
+	BC_STATUS sts;
+
+	if (!snapshot)
+		return BC_STS_INV_ARG;
+	sts = crystalhd_flea_mfd_scl_guard(hw, generation, owner, 1, false,
+					&snapshot[2]);
+	if (sts != BC_STS_SUCCESS)
+		return sts;
+	snapshot[0] = hw->pfnReadDevRegister(hw->adp, BCHP_SCL_HD_TEST_PORT_DATA);
+	if (!READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault))
+		return BC_STS_IO_ERROR;
+	snapshot[1] = hw->pfnReadDevRegister(hw->adp, BCHP_SCL_HD_BVB_IN_STATUS);
+	if (!READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault) ||
+	    (snapshot[1] & BCHP_SCL_HD_BVB_IN_STATUS_reserved0_MASK))
+		return BC_STS_IO_ERROR;
+	return crystalhd_flea_mfd_scl_guard(hw, generation, owner, 1, false,
+					 &snapshot[3]);
+}
