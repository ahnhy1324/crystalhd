+		      !dram_reads && !dram_writes && !fpga_reads && !fpga_writes && !cmac_writes &&
+		      !arm_run_writes && !heartbeats && state_unchanged(),
+		      "final guarded selector restoration is sole last write and leaves host/firmware metadata and other targets untouched");
+		check(run_close() == BC_STS_SUCCESS && suspend_calls == 1 && !hardware.dev_started && !fatal_stops,
+		      "combined deliberate abort retires only through checked actual stock-close ordering");
+	}
+}
