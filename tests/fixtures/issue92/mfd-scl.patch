+static void mfd_scl_context_results(void)
+{
+	groups++;
+	for (unsigned fault = 0; fault < 21; ++fault) {
+		reset_mfd_scl(); struct crystalhd_hw *hw = &hardware;
+		u64 generation = adapter.generation; const void *owner = &research_owner;
+		switch (fault) {
+		case 0: hw = NULL; break; case 1: hardware.adp = NULL; break;
+		case 2: adapter.pdev = NULL; break; case 3: generation = 0; break;
+		case 4: owner = NULL; break; case 5: generation++; break;
+		case 6: owner = &hardware; break; case 7: hardware.pfnReadDevRegister = NULL; break;
+		case 8: hardware.pfnWriteDevRegister = NULL; break; case 9: adapter.present = 0; break;
+		case 10: adapter.hw_accessible = false; break; case 11: hardware.dma_fault = true; break;
+		case 12: adapter.cmds.state = 1; break; case 13: adapter.cfg_users = 1; break;
+		case 14: hardware.RxCaptureState = 1; break; case 15: hardware.FwCmdCnt = 1; break;
+		case 16: hardware.tx_actq->head = NULL; break; case 17: hardware.rx_freeq->count = 1; break;
+		case 18: hardware.rx_rdyq->tail = &hardware.rx_actq->head; break;
+		case 19: hardware.fwcmd_poisoned = true; break; case 20: adapter.cmds.session_module_pinned = false; break;
+		}
+		check(crystalhd_flea_mfd_scl_probe(hw, generation, owner, colour_selected) != BC_STS_CMD_CANCELLED &&
+		      no_effects() && !pci_reads && !pci_clears && !mfd_scl_target_writes && !fatal_stops,
+		      "combined invalid arguments, module/owner/queue/capture identity refuse before any effects");
+	}
+	const uint32_t colours[] = {0, 1, 0x00405ac2, 0x00b2d32a, 0xff405ac3, UINT32_MAX};
+	for (unsigned n = 0; n < ARRAY_SIZE(colours); ++n) {
+		reset_mfd_scl(); colour_selected = colours[n];
+		check(run_mfd_scl() == BC_STS_INV_ARG && no_effects() && !pci_clears,
+		      "combined invalid fixed-colour argument has zero hardware effects");
+	}
+	const struct { unsigned field; uint32_t value; } invalid[] = {
+		{0,0}, {0,0x81}, {0,0xffff}, {0,0x10080}, {1,0}, {1,4}, {1,0xe}, {1,0x1c},
+		{2,1}, {2,0x80000000}, {3,1}, {3,4}, {4,1}, {4,0x80}, {4,0x100},
+	};
+	for (unsigned n = 0; n < ARRAY_SIZE(invalid); ++n) {
+		reset_mfd_scl(); scl_values[invalid[n].field] = invalid[n].value;
+		check(run_mfd_scl() != BC_STS_CMD_CANCELLED && !mfd_scl_target_writes && !colour_starts &&
+		      !pci_clears && !fatal_stops && !hardware.research_mfd_deliberate_abort,
+		      "combined pre-START exact bank qualification rejects drift before isolation or target writes");
+	}
+}
