+static void mfd_scl_sample_results(void)
+{
+	groups++;
+	reset_mfd_scl();
+	check(run_mfd_scl_guard(0, true, NULL) == BC_STS_INV_ARG && no_effects(),
+	      "combined guard refuses a NULL owned status scalar before hardware");
+	check(run_mfd_scl_sample(NULL) == BC_STS_INV_ARG && no_effects(),
+	      "combined sample refuses a NULL four-word destination before hardware");
+	for (unsigned before = 0; before < 2; ++before) {
+		reset_mfd_scl(); uint32_t status = UINT32_MAX;
+		check(run_mfd_scl_guard(0, before, &status) == BC_STS_SUCCESS && !status &&
+		      colour_reads == (before ? 10U : 9U) && !pci_reads && !dev_writes,
+		      "before-feed guard alone adds command-zero; active guard has nine literal reads and no command check");
+	}
+	for (unsigned bit = 0; bit < 32; ++bit) {
+		reset_mfd_scl(); scl_values[4] = 1U << bit; uint32_t status = 0;
+		check(run_mfd_scl_guard(0, false, &status) == (bit < 8 ? BC_STS_SUCCESS : BC_STS_IO_ERROR) &&
+		      (bit >= 8 || status == (1U << bit)) && !dev_writes,
+		      "active guard preserves each defined low-eight error bit and rejects every reserved status bit");
+		reset_mfd_scl(); scl_values[4] = 1U << bit;
+		check(run_mfd_scl_guard(0, true, &status) == (bit < 8 ? BC_STS_SUCCESS : BC_STS_IO_ERROR) &&
+		      (bit >= 8 || status == (1U << bit)) && !dev_writes,
+		      "before-feed guard preserves defined status for its caller's zero-status admission decision");
+	}
+	const unsigned status_positions[] = {9, 11, 20};
+	for (unsigned point = 0; point < ARRAY_SIZE(status_positions); ++point) {
+		for (unsigned bit = 0; bit < 8; ++bit) {
+			reset_mfd_scl(); colour_starts = 1; scl_values[3] = 1;
+			colour_fault_read = status_positions[point]; colour_fault_value = 1U << bit;
+			struct { uint32_t a, words[4], b; } result = {0x12345678, {0}, 0xabcdef01};
+			check(run_mfd_scl_sample(result.words) == BC_STS_SUCCESS && colour_reads == 20 &&
+			      result.a == 0x12345678 && result.b == 0xabcdef01 && result.words[0] == mfd_scl_data &&
+			      result.words[point == 0 ? 2 : point == 1 ? 1 : 3] == (1U << bit) &&
+			      !dev_writes && mfd_scl_observations == 1,
+			      "sample preserves transient pre/main/post status separately inside exact four-word canaries");
+		}
+	}
+	const uint32_t opaque[] = {0, 1, UINT32_MAX, 0x30061000, 0x00540000, 0x00050000};
+	for (unsigned n = 0; n < ARRAY_SIZE(opaque); ++n) {
+		reset_mfd_scl(); colour_starts = 1; scl_values[3] = 1; mfd_scl_data = opaque[n];
+		uint32_t words[4];
+		check(run_mfd_scl_sample(words) == BC_STS_SUCCESS && words[0] == opaque[n] &&
+		      !words[1] && !words[2] && !words[3] && !dev_writes && !dram_reads && !fpga_reads,
+		      "all 32-bit DATA patterns remain opaque, never admitted as pointer or readiness");
+	}
+}
