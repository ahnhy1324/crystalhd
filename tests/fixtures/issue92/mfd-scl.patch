+/* Phase-specific combined observation guard. The pinned words qualify this
+ * observed pre-boot profile, not scaler idle or downstream isolation. Defined
+ * status bits are observations; only reserved bits invalidate readable state.
+ * A feed-command-zero premise applies ONLY before our sole MFD START.
+ */
+static BC_STATUS crystalhd_flea_mfd_scl_guard(struct crystalhd_hw *hw,
+					   uint64_t generation, const void *owner,
+					   uint32_t selector, bool before_feed,
+					   uint32_t *status)
+{
+	static const uint32_t addresses[] = {
+		BCHP_SCL_HD_REVISION_ID, BCHP_SCL_HD_TOP_CONTROL,
+		BCHP_SCL_HD_ENABLE, BCHP_SCL_HD_TEST_PORT_CONTROL,
+		BCHP_SCL_HD_BVB_IN_STATUS,
+	};
+	uint32_t expected[] = { 0x80, 0x0c, 0, selector, 0 };
+	uint32_t value;
+	unsigned int i;
+	BC_STATUS sts;
+
+	if (!status || selector > 1)
+		return BC_STS_INV_ARG;
+	*status = 0;
+	sts = crystalhd_flea_mfd_colour_guard(hw, generation, owner);
+	if (sts != BC_STS_SUCCESS)
+		return hw && hw->research_mfd_pci_isolated ? BC_STS_IO_ERROR : sts;
+	if (before_feed) {
+		value = hw->pfnReadDevRegister(hw->adp, BCHP_MFD_PIC_FEED_CMD);
+		if (!READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault))
+			return BC_STS_IO_ERROR;
+		if (value)
+			return hw->research_mfd_pci_isolated ? BC_STS_IO_ERROR : BC_STS_BUSY;
+	}
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		value = hw->pfnReadDevRegister(hw->adp, addresses[i]);
+		if (!READ_ONCE(hw->adp->present) || READ_ONCE(hw->dma_fault))
+			return BC_STS_IO_ERROR;
+		if (i + 1 == ARRAY_SIZE(addresses)) {
+			if (value & BCHP_SCL_HD_BVB_IN_STATUS_reserved0_MASK) {
+				dev_info(&hw->adp->pdev->dev,
+					 "issue92 mfd-scl: guard-reject address=%08x reserved-status=%08x\n",
+					 addresses[i], value);
+				return BC_STS_IO_ERROR;
+			}
+			*status = value;
+		} else if (value != expected[i]) {
+			dev_info(&hw->adp->pdev->dev,
+				 "issue92 mfd-scl: guard-reject address=%08x expected=%08x observed=%08x\n",
+				 addresses[i], expected[i], value);
+			return BC_STS_IO_ERROR;
+		}
+	}
+	return BC_STS_SUCCESS;
+}
