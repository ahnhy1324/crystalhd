+static void mfd_scl_download_results(void)
+{
+	groups++;
+	const uint32_t colours[] = {0x00405ac3, 0x00b2d32b};
+	for (unsigned n = 0; n < ARRAY_SIZE(colours); ++n) {
+		reset_mfd_scl(); colour_selected = colours[n];
+		hardware.research_staging_probe = hardware.research_mfd_scl_probe = true;
+		hardware.research_mfd_colour_value = colour_selected;
+		check(crystalhd_flea_download_fw(&hardware, (const uint8_t *)firmware.words, sizeof(firmware.words)) ==
+		      BC_STS_CMD_CANCELLED && mfd_scl_calls == 1 && !colour_calls && !scl_calls && !mfd_calls &&
+		      dram_writes == 3 && dram_reads == 3 && !memcmp(card_prefix, expected_image, sizeof(card_prefix)) &&
+		      card_suffix == expected_image[24] && !hardware.research_mfd_scl_probe &&
+		      !hardware.research_mfd_colour_value && !hardware.research_mfd_generation &&
+		      !hardware.research_mfd_owner && !cmac_writes && !arm_run_writes && !heartbeats &&
+		      mfd_scl_pre_observations == 1 && mfd_scl_observations == 17 && mfd_scl_target_writes == 44,
+		      "both combined downloader colours consume flags, restore loader prefix and abort without firmware commands");
+		const unsigned reads = dev_reads, writes = dev_writes;
+		check(crystalhd_flea_download_fw(&hardware, (const uint8_t *)firmware.words, sizeof(firmware.words)) ==
+		      BC_STS_INV_ARG && dev_reads == reads && dev_writes == writes && mfd_scl_calls == 1,
+		      "a consumed persistently isolated combined transaction never replays or boots firmware");
+	}
+	for (unsigned fault = 0; fault < 13; ++fault) {
+		reset_mfd_scl(); hardware.research_staging_probe = hardware.research_mfd_scl_probe = true;
+		hardware.research_mfd_colour_value = colour_selected;
+		switch (fault) {
+		case 0: hardware.research_staging_probe = false; break;
+		case 1: hardware.research_mfd_owner = NULL; break;
+		case 2: hardware.research_mfd_generation = 0; break;
+		case 3: hardware.research_mfd_latch_probe = true; break;
+		case 4: hardware.research_mfd_colour_probe = true; break;
+		case 5: hardware.research_scl_port_probe = true; break;
+		case 6: hardware.research_scl_port_latch = true; break;
+		case 7: hardware.research_mfd_colour_value = 0; break;
+		case 8: hardware.research_mfd_pci_isolated = true; break;
+		case 9: hardware.research_mfd_deliberate_abort = true; break;
+		case 10: hardware.pfnDevDRAMRead = NULL; break;
+		case 11: hardware.research_mfd_generation++; break;
+		case 12: hardware.research_mfd_colour_value = 0x00405ac2; break;
+		}
+		check(crystalhd_flea_download_fw(&hardware, (const uint8_t *)firmware.words, sizeof(firmware.words)) !=
+		      BC_STS_SUCCESS && no_effects() && !mfd_scl_calls && !pci_clears &&
+		      !hardware.research_mfd_scl_probe && !hardware.research_mfd_colour_value,
+		      "combined invalid/private/mutually exclusive fields consume then reject before ordinary loader effects");
+	}
+	for (unsigned field = 0; field < 5; ++field) {
+		reset_mfd_scl(); hardware.research_staging_probe = hardware.research_mfd_scl_probe = true;
+		hardware.research_mfd_colour_value = colour_selected; scl_values[field] = field ? 1U : 0;
+		check(crystalhd_flea_download_fw(&hardware, (const uint8_t *)firmware.words, sizeof(firmware.words)) !=
+		      BC_STS_CMD_CANCELLED && !dev_writes && !dram_reads && !dram_writes && !pci_clears && !mfd_scl_calls,
+		      "fresh combined bank admission precedes DRAM/security loader effects and the probe wrapper");
+	}
+}
