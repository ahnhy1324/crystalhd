+static void mfd_scl_error_results(void)
+{
+	groups++;
+	for (unsigned ordinal = 0; ordinal < 17; ++ordinal) {
+		for (unsigned bit = 0; bit < 8; ++bit) {
+			reset_mfd_scl(); mfd_scl_error_ordinal = ordinal; mfd_scl_error = 1U << bit;
+			check(run_mfd_scl() == BC_STS_CMD_CANCELLED && hardware.research_mfd_deliberate_abort &&
+			      !fatal_stops && colour_starts == 1 && colour_pulses == ordinal &&
+			      mfd_scl_pre_observations == 1 && mfd_scl_observations == ordinal + 1 &&
+			      colour_writes == 10 + 2 * ordinal && mfd_scl_target_writes == 12 + 2 * ordinal &&
+			      mfd_scl_selector_writes == 2 && scl_values[3] == 0 && scl_values[4] == (1U << bit),
+			      "each defined SCL error at every active ordinal stops all future pulses and restores selector exactly once");
+			check(!fpga_reads && !fpga_writes && !dram_reads && !dram_writes &&
+			      !cmac_writes && !arm_run_writes && !heartbeats && !(pci_command & PCI_COMMAND_MASTER),
+			      "defined errors are observations, never clear/write/source-follow or firmware boot permission");
+		}
+	}
+}
+
+static void mfd_scl_fault_results(void)
+{
+	groups++;
+	uint32_t baseline[ARRAY_SIZE(colour_read_offsets)];
+	reset_mfd_scl();
+	check(run_mfd_scl() == BC_STS_CMD_CANCELLED, "capture complete combined literal trace for every-position faults");
+	const unsigned reads = colour_reads, pcis = pci_reads, start_boundary = colour_start_read_count;
+	memcpy(baseline, colour_read_offsets, sizeof(baseline));
+	for (unsigned position = 1; position <= start_boundary; ++position) {
+		if (baseline[position - 1] != 0x5408a4) continue;
+		reset_mfd_scl(); colour_fault_read = position; colour_fault_value = 1;
+		check(run_mfd_scl() == (position == 10 ? BC_STS_BUSY : BC_STS_CMD_CANCELLED) &&
+		      !fatal_stops && !colour_starts && colour_writes == colour_fault_writes &&
+		      mfd_scl_target_writes == mfd_scl_writes_at_fault +
+		      (mfd_scl_selector_writes_at_fault == 1 ? 1U : 0U) &&
+		      !scl_values[3],
+		      "defined errors at every pre-START status boundary prohibit START and only restore an already-selected port");
+	}
+	for (unsigned position = 1; position <= pcis; ++position) {
+		reset_mfd_scl(); pci_fail_at = position;
+		check(run_mfd_scl() == BC_STS_IO_ERROR && pci_reads == position && fatal_stops == 1 &&
+		      mfd_scl_target_writes == mfd_scl_writes_at_fault && colour_retained() &&
+		      !hardware.research_mfd_deliberate_abort,
+		      "every combined PCI transport failure has no retry, subsequent REG or blind selector restoration");
+	}
+	for (unsigned position = 1; position <= pcis; ++position) {
+		if (position % 3 == 2) continue;
+		reset_mfd_scl(); colour_pci_flip_at = position;
+		check(run_mfd_scl() == BC_STS_IO_ERROR && pci_reads == position && fatal_stops == 1 &&
+		      mfd_scl_target_writes == mfd_scl_writes_at_fault && colour_retained(),
+		      "MASTER reassertion at every checked combined COMMAND anchor stops writes and retains backing");
+	}
+	for (unsigned position = 1; position <= reads; ++position) {
+		for (unsigned kind = 1; kind <= 2; ++kind) {
+			reset_mfd_scl(); colour_state_fault_read = position; colour_state_fault_kind = kind;
+			check(run_mfd_scl() == BC_STS_IO_ERROR && mfd_scl_target_writes == mfd_scl_writes_at_fault &&
+			      !hardware.research_mfd_deliberate_abort && colour_reads <= position + 4,
+			      "access loss at every combined REG boundary prevents all later target writes and further guard batches");
+			check(fatal_stops == (hardware.research_mfd_pci_isolated ? 1U : 0U),
+			      "post-isolation access failure quarantines; pre-isolation failure has no new containment effects");
+			if (baseline[position - 1] >= 0x540800)
+				check(colour_reads == position,
+				      "each added SCL scalar read checks access immediately before any following REG read");
+		}
+	}
+	for (unsigned position = 1; position <= reads; ++position) {
+		const uint32_t offset = baseline[position - 1];
+		uint32_t bad;
+		if (offset == 0x540000) bad = 0x51;
+		else if (offset == 0x4000d4) bad = 1;
+		else if (offset == 0xe0004) bad = ARM_RUN_REQ_BIT;
+		else if (offset == 0x540064) bad = UINT32_MAX;
+		else if (offset == 0x540800) bad = 0x81;
+		else if (offset == 0x540804) bad = 4;
+		else if (offset == 0x540854) bad = 1;
+		else if (offset == 0x5408a4) bad = 0x100;
+		else if (offset == 0x540880) bad = 4;
+		else if (offset == 0x540078 || offset == 0x540080 || offset == 0x540050 ||
+			 offset == 0x540070 || offset == 0x54006c) bad = UINT32_MAX;
+		else continue;
+		reset_mfd_scl(); colour_fault_read = position; colour_fault_value = bad;
+		check(run_mfd_scl() != BC_STS_CMD_CANCELLED && !hardware.research_mfd_deliberate_abort &&
+		      mfd_scl_target_writes == mfd_scl_writes_at_fault,
+		      "every invalid identity/reserved/error scalar is rejected without a later write or blind restoration");
+		if (pci_clears) check(fatal_stops == 1 && colour_retained(),
+		      "isolated invalid raw observations retain backing for quarantine, not ordinary boot");
+	}
+	for (unsigned position = start_boundary + 1; position <= reads; ++position) {
+		if (baseline[position - 1] != 0x5408a4) continue;
+		reset_mfd_scl(); colour_fault_read = position; colour_fault_value = 1;
+		const BC_STATUS result = run_mfd_scl();
+		const unsigned finish_low = colour_fault_writes >= 11 && (colour_fault_writes & 1);
+		check(result == BC_STS_CMD_CANCELLED && !fatal_stops &&
+		      colour_writes == colour_fault_writes + finish_low && mfd_scl_selector_writes == 2 && scl_values[3] == 0 &&
+		      mfd_scl_target_writes == mfd_scl_writes_at_fault + finish_low +
+		      (mfd_scl_selector_writes_at_fault == 1 ? 1U : 0U) &&
+		      (!finish_low || (colour_write_offsets[colour_writes - 1] == 0x540074 &&
+		      colour_write_values[colour_writes - 1] == 8)),
+		      "defined active errors start no later pulse; only a previously raised low edge may finish before selector restore");
+	}
+	for (unsigned mismatch = 0; mismatch < 2; ++mismatch) {
+		reset_mfd_scl(); if (!mismatch) scl_toggle_mismatch = true; else scl_restore_mismatch = true;
+		check(run_mfd_scl() == BC_STS_IO_ERROR && fatal_stops == 1 && colour_retained() &&
+		      mfd_scl_selector_writes == (mismatch ? 2U : 1U) && !hardware.research_mfd_deliberate_abort,
+		      "selector identity mismatch is quarantined without retry or an unguarded restoration");
+	}
+}
