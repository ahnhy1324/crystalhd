+	unsigned count = 0;
+	mfd_scl_append(output,&count,pre,10);
+	mfd_scl_append(output,&count,admission,5);
+	mfd_scl_append(output,&count,controls,9);
+	mfd_scl_append(output,&count,pre,10); /* after isolation */
+	for (unsigned n = 0; n < 9; ++n) {
+		mfd_scl_append(output,&count,pre,10);
+		mfd_scl_append(output,&count,controls+n,1);
+	}
+	mfd_scl_append(output,&count,pre,10);
+	mfd_scl_append(output,&count,mfd_raw,2);
+	mfd_scl_append(output,&count,pre,10); /* selector-one admission */
+	mfd_scl_append(output,&count,pre,10); /* selector-one readback */
+	mfd_scl_append(output,&count,active,9);
+	mfd_scl_append(output,&count,scl_raw,2); /* separate pre-START baseline */
+	mfd_scl_append(output,&count,active,9);
