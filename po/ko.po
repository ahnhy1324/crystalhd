msgid "_H.264 input policy"
msgstr "H.264 입력 정책(_H)"

msgid "E_xplicit prefeed"
msgstr "명시적 선행 입력(_X)"

msgid "READY re_mapping"
msgstr "READY 재매핑(_M)"

msgid "i915 _write combining"
msgstr "i915 쓰기 결합(_W)"

msgid "Receive _buffers"
msgstr "수신 버퍼(_B)"

msgid "VA _debug logging"
msgstr "VA 디버그 로그 기록(_D)"

msgid "VA timing _trace"
msgstr "VA 타이밍 추적(_T)"

msgid "Saved experiments need an explicitly acknowledged launch. Ordinary applications may ignore these saved requests."
msgstr "저장된 실험 설정을 적용하려면 위험을 명시적으로 확인하고 실행해야 합니다. 일반 애플리케이션은 이러한 저장 요청을 무시할 수 있습니다."

msgid "Updated CrystalHD components read supported defaults when an app starts. See Installation for file declarations; running apps are not inspected."
msgstr "업데이트된 CrystalHD 구성 요소는 앱이 시작될 때 지원하는 기본 설정을 읽습니다. 파일에 명시된 지원 정보는 설치 탭에서 확인하세요. 실행 중인 앱은 검사하지 않습니다."

msgid "Save outcome is uncertain. Inspect the file and Reload before another write."
msgstr "저장 결과가 확실하지 않습니다. 다시 쓰기 전에 파일을 확인하고 다시 읽으세요."

msgid "Saved, but readback changed or failed. Reload before another write."
msgstr "저장했지만 다시 읽은 내용이 달라졌거나 읽기에 실패했습니다. 다시 쓰기 전에 다시 읽으세요."

msgid "Saved, but durability is unconfirmed. Inspect the file and Reload before another write."
msgstr "저장했지만 영구 저장 여부는 확인되지 않았습니다. 다시 쓰기 전에 파일을 확인하고 다시 읽으세요."

msgid "Defaults saved. Restart applications to read them; active state is unconfirmed."
msgstr "기본 설정을 저장했습니다. 애플리케이션을 다시 시작해야 설정을 읽습니다. 현재 적용 상태는 확인되지 않았습니다."

msgid "CrystalHD Settings"
msgstr "CrystalHD 설정"

msgid "Defaults for next playback"
msgstr "다음 재생에 적용할 기본 설정"

msgid "Profiles and presets"
msgstr "프로필 및 프리셋"

msgid "Player"
msgstr "플레이어"

msgid "Decoder defaults"
msgstr "디코더 기본 설정"

msgid "Advanced"
msgstr "고급"

msgid "_Preset"
msgstr "프리셋(_P)"

msgid "Presets provide defaults, not overrides. Player-only presets affect crystalhd-play, not Kodi."
msgstr "프리셋은 기본 설정을 제공하며, 재정의 설정보다 우선하지 않습니다. 플레이어 전용 프리셋은 crystalhd-play에만 적용되며 Kodi에는 적용되지 않습니다."

msgid "Profile used by de_fault"
msgstr "기본으로 사용할 프로필(_F)"

msgid "Select the profile for future application starts. Selecting what to edit below does not change this choice."
msgstr "앞으로 애플리케이션을 시작할 때 사용할 프로필을 선택하세요. 아래에서 편집할 대상을 선택해도 이 선택은 바뀌지 않습니다."

msgid "Settings to _edit"
msgstr "편집할 설정(_E)"

msgid "Edit user defaults or a named profile. Changing this view keeps all unsaved edits and does not select the default profile."
msgstr "사용자 기본 설정이나 이름이 지정된 프로필을 편집합니다. 편집 대상을 바꿔도 저장하지 않은 변경 사항은 모두 유지되며 기본 프로필은 바뀌지 않습니다."

msgid "_New profile…"
msgstr "새 프로필(_N)…"

msgid "Remove _user profile…"
msgstr "사용자 프로필 제거(_U)…"

msgid "Model value and origin: "
msgstr "모델 값 및 출처: "

msgid "_Video decoder"
msgstr "비디오 디코더(_V)"

msgid "Card output _width"
msgstr "카드 출력 너비(_W)"

msgid "Card width v_alue"
msgstr "카드 너비 값(_A)"

msgid "0 or an even width from 128 to 1918"
msgstr "0 또는 128~1918 사이의 짝수 너비"

msgid "Software _output size"
msgstr "소프트웨어 출력 크기(_O)"

msgid "Output size valu_e"
msgstr "출력 크기 값(_Z)"

msgid "WIDTHxHEIGHT, for example 1920x1080"
msgstr "WIDTHxHEIGHT 형식, 예: 1920x1080"

msgid "Preview and source: "
msgstr "미리 보기 및 출처: "

msgid "Only updated crystalhd-play reads these defaults; see Installation for its reader declaration. Other players keep their own controls. Scaling needs hardware decoding; software resizing also needs a nonzero card width. Interlaced H.264 widths must be multiples of 16. Saving takes effect on the next playback."
msgstr "업데이트된 crystalhd-play만 이 기본 설정을 읽습니다. 설정 읽기 지원 정보는 설치 탭에서 확인하세요. 다른 플레이어는 자체 설정을 사용합니다. 크기 조정에는 하드웨어 디코딩이 필요하며, 소프트웨어 크기 조정에는 카드 너비도 0이 아닌 값으로 설정해야 합니다. 인터레이스 H.264의 너비는 16의 배수여야 합니다. 저장한 설정은 다음 재생부터 적용됩니다."

msgid "These controls can clear saved experiments. Activation requires an explicit acknowledged launch; it is not enabled by this editor. Off for explicit prefeed still allows eligible automatic prefeed."
msgstr "이 항목들로 저장된 실험 설정을 해제할 수 있습니다. 실험 기능을 활성화하려면 위험을 명시적으로 확인하고 실행해야 하며, 이 편집기에서는 활성화할 수 없습니다. 명시적 선행 입력을 꺼도 조건에 맞는 자동 선행 입력은 허용됩니다."

msgid "Configuration model and origins"
msgstr "설정 모델 및 출처"

msgid "Setting"
msgstr "설정 항목"

msgid "Value (model)"
msgstr "값(모델)"

msgid "Origin"
msgstr "출처"

msgid "Use / timing"
msgstr "사용처 / 적용 시점"

msgid "Native model state"
msgstr "네이티브 모델 상태"

msgid "Details"
msgstr "상세 정보"

msgid "Refresh _installation status"
msgstr "설치 상태 새로 고침(_I)"

msgid "Read component declarations and the completed on-disk userspace receipt. Does not save settings, load a decoder, inspect running mappings or restart applications."
msgstr "구성 요소의 지원 선언과 디스크에 저장된 사용자 공간 설치 완료 기록을 읽습니다. 설정 저장, 디코더 로드, 실행 중인 메모리 매핑 검사, 애플리케이션 재시작은 수행하지 않습니다."

msgid "Installation"
msgstr "설치"

msgid "User file: "
msgstr "사용자 파일: "

msgid "_Reload file"
msgstr "파일 다시 읽기(_R)"

msgid "Reread saved files. Ask before discarding any unsaved changes."
msgstr "저장된 파일을 다시 읽습니다. 저장하지 않은 변경 사항을 버리기 전에 확인합니다."

msgid "_Clear all user settings…"
msgstr "모든 사용자 설정 지우기(_C)…"

msgid "Delete all saved user overrides and profiles after confirmation. System settings remain."
msgstr "확인 후 저장된 사용자 재정의 설정과 프로필을 모두 삭제합니다. 시스템 설정은 유지됩니다."

msgid "_Save changes"
msgstr "변경 사항 저장(_S)"

msgid "Save every edited profile and user default. Running applications are unchanged."
msgstr "편집한 모든 프로필과 사용자 기본 설정을 저장합니다. 실행 중인 애플리케이션에는 영향을 주지 않습니다."

msgid "_Close"
msgstr "닫기(_C)"

msgid "_Quit"
msgstr "종료(_Q)"

msgid "Exit the settings app and remove its tray icon. Ask before discarding unsaved changes."
msgstr "설정 앱을 종료하고 트레이 아이콘을 제거합니다. 저장하지 않은 변경 사항을 버리기 전에 확인합니다."

msgid "Inspecting installed components…"
msgstr "설치된 구성 요소 검사 중…"

msgid "Installation inspection failed. Refresh to retry."
msgstr "설치 상태 검사에 실패했습니다. 새로 고침하여 다시 시도하세요."

msgid " (saved; unavailable here)"
msgstr " (저장됨; 여기서는 사용할 수 없음)"

msgid "Enter 0 for native width, or an even number from 128 to 1918."
msgstr "원본 너비를 사용하려면 0을, 그 외에는 128~1918 사이의 짝수를 입력하세요."

msgid "Enter WIDTHxHEIGHT: positive even dimensions, each at most 4096, total at most 4096×2160."
msgstr "WIDTHxHEIGHT 형식으로 입력하세요. 너비와 높이는 각각 4096 이하의 양의 짝수이며, 총 픽셀 수는 4096×2160 이하여야 합니다."

msgid "Inherit preset"
msgstr "프리셋 상속"

msgid "standard"
msgstr "표준"

msgid "Player only"
msgstr "플레이어 전용"

msgid "acknowledged CLI launch only"
msgstr "위험을 확인한 CLI 실행에서만 적용"

msgid "unavailable here"
msgstr "여기서는 사용할 수 없음"

msgid "Use system profile selection"
msgstr "시스템의 프로필 선택 사용"

msgid "User defaults (before profile overrides)"
msgstr "사용자 기본 설정(프로필 재정의 적용 전)"

msgid " (user overrides)"
msgstr " (사용자 재정의)"

msgid " (system; edit adds user overrides)"
msgstr " (시스템; 편집하면 사용자 재정의 추가)"

msgid "Off"
msgstr "끔"

msgid "On"
msgstr "켬"

msgid "Automatic / bounded"
msgstr "자동 / 제한 모드"

msgid "Strict finite"
msgstr "엄격한 유한 입력 모드"

msgid "16 buffers (standard)"
msgstr "버퍼 16개(표준)"

msgid "Follow preset/system defaults"
msgstr "프리셋/시스템 기본 설정 따름"

msgid "Follow defaults/system profile"
msgstr "기본 설정/시스템 프로필 따름"

msgid "Use built-in default"
msgstr "내장 기본값 사용"

msgid "CrystalHD hardware (required)"
msgstr "CrystalHD 하드웨어(필수)"

msgid "Software decoding (CPU)"
msgstr "소프트웨어 디코딩(CPU)"

msgid "Set a value"
msgstr "값 지정"

msgid "Hardware requires actual CrystalHD output and never silently falls back. Software uses the CPU. Built-in default: hardware."
msgstr "하드웨어 모드에서는 실제 CrystalHD 출력이 필요하며, 소프트웨어 모드로 자동 전환하지 않습니다. 소프트웨어 모드는 CPU를 사용합니다. 내장 기본값: 하드웨어."

msgid "Card width controls pixels transferred over PCIe, not display size. Smaller output loses detail. Built-in default: 0, native width."
msgstr "카드 너비는 화면 표시 크기가 아니라 PCIe로 전송하는 픽셀 수를 조절합니다. 출력 크기를 줄이면 세부 정보가 손실됩니다. 내장 기본값: 0(원본 너비)."

msgid "Optional CPU resize after card scaling; it cannot recover lost detail. Built-in default: no software resize."
msgstr "카드에서 크기를 조정한 뒤 CPU로 크기를 추가 조정할 수 있습니다. 손실된 세부 정보는 복구할 수 없습니다. 내장 기본값: 소프트웨어 크기 조정 없음."

msgid "Follow defaults removes this override and uses other saved settings. Built-in default ignores those settings. Explicit CLI overrides still win."
msgstr "기본 설정 따름을 선택하면 이 재정의 설정을 제거하고 다른 저장된 설정을 사용합니다. 내장 기본값은 해당 설정들을 무시합니다. CLI에서 명시한 재정의 설정은 항상 우선합니다."

msgid "Previewing editing profile, not the application's default selection. "
msgstr "애플리케이션의 기본 선택 대신 현재 편집 중인 프로필을 미리 봅니다. "

msgid "Native file reading is bypassed in this settings process's environment."
msgstr "이 설정 프로세스의 환경에서는 네이티브 구성 요소가 설정 파일을 읽지 않습니다."

msgid "Explicit prefeed Off still permits eligible automatic prefeed."
msgstr "명시적 선행 입력을 꺼도 조건에 맞는 자동 선행 입력은 허용됩니다."

msgid "Next start in updated VA/DIL; not confirmed active"
msgstr "업데이트된 VA/DIL의 다음 시작 시 적용; 현재 적용 여부는 미확인"

msgid "Next start in updated crystalhd-play; not confirmed active"
msgstr "업데이트된 crystalhd-play의 다음 시작 시 적용; 현재 적용 여부는 미확인"

msgid "Saved only; automatic consumer unavailable"
msgstr "저장만 됨; 자동으로 읽는 구성 요소를 사용할 수 없음"

msgid "Launch-only; native transaction may be ignored"
msgstr "명시적 실행에서만 적용; 네이티브 설정 트랜잭션이 무시될 수 있음"

msgid "Experimental preset; ordinary crystalhd-play ignores this managed overlay"
msgstr "실험용 프리셋; 일반 crystalhd-play는 이 관리형 설정 계층을 무시함"

msgid "Environment override in this settings process; application state unconfirmed"
msgstr "이 설정 프로세스의 환경 변수 재정의; 애플리케이션 상태는 미확인"

msgid "Built-in default"
msgstr "내장 기본값"

msgid "User defaults"
msgstr "사용자 기본 설정"

msgid "System settings"
msgstr "시스템 설정"

msgid "User profile"
msgstr "사용자 프로필"

msgid "System profile"
msgstr "시스템 프로필"

msgid "Preset"
msgstr "프리셋"

msgid "Environment override"
msgstr "환경 변수 재정의"

msgid "Preview: "
msgstr "미리 보기: "

msgid "From: "
msgstr "출처: "

msgid "Model unavailable"
msgstr "모델을 사용할 수 없음"

msgid "Unsaved changes"
msgstr "저장하지 않은 변경 사항"

msgid "Settings loaded; running applications have not been inspected"
msgstr "설정을 읽었습니다. 실행 중인 애플리케이션은 검사하지 않았습니다."

msgid "Some inspected components do not advertise settings support; see Installation."
msgstr "검사한 구성 요소 중 일부는 설정 지원을 명시하지 않습니다. 설치 탭을 확인하세요."

msgid "Editing profile: "
msgstr "편집 중인 프로필: "

msgid "Editing user defaults"
msgstr "사용자 기본 설정 편집 중"

msgid "Default profile: "
msgstr "기본 프로필: "

msgid "None"
msgstr "없음"

msgid "Finish invalid Player values before saving, including values in other profiles."
msgstr "저장하기 전에 다른 프로필을 포함한 모든 플레이어 설정에서 잘못된 값을 수정하세요."

msgid "Settings conflict: "
msgstr "설정 충돌: "

msgid "Configuration could not be loaded: "
msgstr "설정을 읽을 수 없습니다: "

msgid "Saved configuration changed outside this window. Drafts are preserved; Reload before saving."
msgstr "이 창 외부에서 저장된 설정이 변경되었습니다. 편집 중인 내용은 유지됩니다. 저장하기 전에 다시 읽으세요."

msgid "Saved configuration could not be checked safely. Drafts are preserved; Reload before saving."
msgstr "저장된 설정을 안전하게 확인할 수 없습니다. 편집 중인 내용은 유지됩니다. 저장하기 전에 다시 읽으세요."

msgid "Checking saved configuration in the background; Save and Clear will resume when it finishes."
msgstr "백그라운드에서 저장된 설정을 확인하고 있습니다. 확인이 끝나면 저장과 지우기를 다시 사용할 수 있습니다."

msgid "Model is partial: native-only environment settings are not validated here."
msgstr "이 모델은 일부 설정만 반영합니다. 네이티브 구성 요소 전용 환경 변수 설정은 여기서 검증하지 않습니다."

msgid "Some requests are rejected by the native model; see the model state column."
msgstr "일부 요청은 네이티브 모델에서 거부되었습니다. 모델 상태 열을 확인하세요."

msgid "Window-only mode; closing exits."
msgstr "창 전용 모드입니다. 창을 닫으면 종료됩니다."

msgid "Tray unavailable; closing this window exits."
msgstr "트레이를 사용할 수 없습니다. 이 창을 닫으면 종료됩니다."

msgid "Hide to tray"
msgstr "트레이로 숨기기"

msgid "Keep settings running; reopen from the tray icon."
msgstr "설정 앱을 계속 실행합니다. 트레이 아이콘에서 다시 열 수 있습니다."

msgid "No tray is available; closing exits the settings app."
msgstr "트레이를 사용할 수 없습니다. 창을 닫으면 설정 앱이 종료됩니다."

msgid "New profile"
msgstr "새 프로필"

msgid "_Cancel"
msgstr "취소(_C)"

msgid "C_reate"
msgstr "만들기(_R)"

msgid "1–64 ASCII letters/digits/._-; start with letter/digit"
msgstr "ASCII 영문자/숫자/._- 1~64자; 영문자 또는 숫자로 시작"

msgid "_Profile name"
msgstr "프로필 이름(_P)"

msgid "Profile added to draft. Select it as Default profile if desired, then Save."
msgstr "편집 중인 내용에 프로필을 추가했습니다. 원하면 기본 프로필로 선택한 뒤 저장하세요."

msgid "Remove this user profile from the draft?"
msgstr "편집 중인 내용에서 이 사용자 프로필을 제거하시겠습니까?"

msgid "System definitions remain. A user default selecting a removed user-only profile becomes inherited. Save is required."
msgstr "시스템의 프로필 정의는 유지됩니다. 제거된 사용자 전용 프로필을 기본으로 선택한 사용자 설정은 해제되고, 시스템의 프로필 선택을 따르게 됩니다. 저장해야 반영됩니다."

msgid "User profile removed from draft; Save to persist."
msgstr "편집 중인 내용에서 사용자 프로필을 제거했습니다. 반영하려면 저장하세요."

msgid "Correct the highlighted Player values before saving."
msgstr "저장하기 전에 강조 표시된 플레이어 설정값을 수정하세요."

msgid "Save launch-only experimental defaults?"
msgstr "명시적 실행에서만 적용되는 실험용 기본 설정을 저장하시겠습니까?"

msgid "This does not enable experiments in ordinary Kodi. An acknowledged launch remains required. Risks: "
msgstr "이 작업으로 일반 Kodi에서 실험 기능이 활성화되지는 않습니다. 위험을 명시적으로 확인한 실행이 여전히 필요합니다. 위험: "

msgid "Keep your edits; Reload to review changes before retrying."
msgstr "편집 내용을 보관해 두세요. 다시 시도하기 전에 파일을 다시 읽어 변경 사항을 확인하세요."

msgid "Discard unsaved changes and reload?"
msgstr "저장하지 않은 변경 사항을 버리고 다시 읽으시겠습니까?"

msgid "Reload reads the current user and system files."
msgstr "다시 읽기는 현재 사용자 파일과 시스템 파일을 읽습니다."

msgid "Clear all saved user settings?"
msgstr "저장된 사용자 설정을 모두 지우시겠습니까?"

msgid "This deletes every user override and profile, including unfinished edits. System settings and process overrides remain."
msgstr "아직 마치지 않은 편집 내용까지 포함하여 모든 사용자 재정의 설정과 프로필을 삭제합니다. 시스템 설정과 프로세스의 재정의 설정은 유지됩니다."

msgid "Discard unsaved changes and quit?"
msgstr "저장하지 않은 변경 사항을 버리고 종료하시겠습니까?"

msgid "Saved defaults remain after this utility exits."
msgstr "이 유틸리티를 종료해도 저장된 기본 설정은 유지됩니다."

msgid "Open settings…"
msgstr "설정 열기…"

msgid "Quit"
msgstr "종료"

msgid "Edit saved CrystalHD defaults; active applications are not reconfigured."
msgstr "저장된 CrystalHD 기본 설정을 편집합니다. 실행 중인 애플리케이션의 설정은 바꾸지 않습니다."

msgid "use a separate window only"
msgstr "별도 창만 사용"

msgid "start in the tray when available; otherwise show the window"
msgstr "트레이를 사용할 수 있으면 트레이에서 시작하고, 그렇지 않으면 창 표시"
