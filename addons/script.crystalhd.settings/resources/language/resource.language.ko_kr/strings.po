msgctxt "#30000"
msgid "CrystalHD settings"
msgstr "CrystalHD 설정"

msgctxt "#30001"
msgid "Preset"
msgstr "프리셋"

msgctxt "#30002"
msgid "Profile"
msgstr "프로필"

msgctxt "#30003"
msgid "Decoder defaults"
msgstr "디코더 기본 설정"

msgctxt "#30004"
msgid "Advanced / diagnostics"
msgstr "고급 / 진단"

msgctxt "#30005"
msgid "Saved values and origins"
msgstr "저장된 값과 출처"

msgctxt "#30006"
msgid "Installation / compatibility"
msgstr "설치 / 호환성"

msgctxt "#30007"
msgid "Save changes — restart Kodi to apply"
msgstr "변경 저장 — 적용하려면 Kodi를 다시 시작하세요"

msgctxt "#30008"
msgid "Restore ALL CrystalHD user defaults…"
msgstr "모든 CrystalHD 사용자 기본 설정 초기화…"

msgctxt "#30009"
msgid "Reload saved values"
msgstr "저장된 값 다시 읽기"

msgctxt "#30010"
msgid "Follow system selection"
msgstr "시스템 선택 따르기"

msgctxt "#30011"
msgid "Follow preset/system defaults"
msgstr "프리셋/시스템 기본 설정 따르기"

msgctxt "#30012"
msgid "Use built-in default"
msgstr "내장 기본값 사용"

msgctxt "#30013"
msgid "Discard unsaved changes?"
msgstr "저장하지 않은 변경을 버릴까요?"

msgctxt "#30014"
msgid "Restart required; live state unknown"
msgstr "재시작 필요; 실행 중 적용 상태는 알 수 없음"

msgctxt "#30015"
msgid "File declarations only. Missing/older readers may ignore saved defaults. This does not inspect the running decoder."
msgstr "파일에 선언된 기능만 표시합니다. 없거나 오래된 구성 요소는 저장된 설정을 무시할 수 있습니다. 실행 중인 디코더는 검사하지 않습니다."

msgctxt "#30016"
msgid "Reload and inspect saved values before another write."
msgstr "다시 저장하기 전에 저장된 값을 다시 읽고 확인하세요."

msgctxt "#30017"
msgid "Remove ALL CrystalHD user overrides and profiles, including settings for other applications? System defaults remain. Restart Kodi to apply."
msgstr "다른 응용 프로그램의 설정을 포함한 모든 CrystalHD 사용자 재정의와 프로필을 지울까요? 시스템 기본 설정은 유지됩니다. 적용하려면 Kodi를 다시 시작하세요."

msgctxt "#30018"
msgid "Save shared defaults? Restart Kodi to apply. Running playback will not be changed."
msgstr "공통 기본 설정을 저장할까요? 적용하려면 Kodi를 다시 시작하세요. 실행 중인 재생은 바뀌지 않습니다."

msgctxt "#30019"
msgid "Saved — restart Kodi to apply. Live decoder state is unknown."
msgstr "저장됨 — 적용하려면 Kodi를 다시 시작하세요. 실행 중인 디코더 적용 상태는 알 수 없습니다."

msgctxt "#30027"
msgid "Automatic / bounded"
msgstr "자동 / 제한된 공급"

msgctxt "#30028"
msgid "Strict finite"
msgstr "엄격한 유한 입력"

msgctxt "#30029"
msgid "On"
msgstr "켜기"

msgctxt "#30030"
msgid "Off"
msgstr "끄기"

msgctxt "#30031"
msgid "Unsaved changes"
msgstr "저장하지 않은 변경"

msgctxt "#30020"
msgid "Receive buffers"
msgstr "수신 버퍼 수"

msgctxt "#30021"
msgid "H.264 input policy"
msgstr "H.264 입력 정책"

msgctxt "#30022"
msgid "Explicit prefeed request"
msgstr "명시적 미리 공급 요청"

msgctxt "#30023"
msgid "READY remapping request"
msgstr "READY 재매핑 요청"

msgctxt "#30024"
msgid "i915 write combining request"
msgstr "i915 쓰기 결합 요청"

msgctxt "#30025"
msgid "VA debug logging"
msgstr "VA 디버그 기록"

msgctxt "#30026"
msgid "VA timing trace"
msgstr "VA 시간 추적"

msgctxt "#30032"
msgid "Device node visible and accessible; decoding has not been tested."
msgstr "장치 노드가 보이고 접근할 수 있습니다. 디코딩은 검사하지 않았습니다."

msgctxt "#30033"
msgid "Device node missing or inaccessible. Defaults can still be saved; usable hardware is not confirmed."
msgstr "장치 노드가 없거나 접근할 수 없습니다. 기본 설정은 저장할 수 있지만 하드웨어 사용 가능 여부는 확인되지 않았습니다."
